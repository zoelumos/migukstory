# Supabase — newsletter subscribers + future auth + comments
# Project URL and publishable key from Project Settings → API → API Keys
# Publishable key is safe in browser (RLS protects tables)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DO NOT commit the secret key. Set in shell env only:
#   echo 'export SUPABASE_SECRET_KEY="sb_secret_..."' >> ~/.zshrc
#   source ~/.zshrc
# Used by Supabase MCP + server-side admin scripts only.
