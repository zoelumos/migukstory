---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`로그인 처리 중 — ${SITE_TITLE}`}
			description="로그인을 처리하고 있습니다…"
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="container narrow">
				<div class="callback">
					<h1>로그인 처리 중…</h1>
					<p data-msg>잠시만 기다려 주세요.</p>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			import { supabase } from '../../lib/supabase';

			(async () => {
				const params = new URLSearchParams(window.location.search);
				const next = params.get('next') || '/';
				const msg = document.querySelector('[data-msg]') as HTMLElement | null;

				// Handle explicit OAuth error from Google (?error=access_denied etc.)
				const oauthErr = params.get('error');
				if (oauthErr) {
					const desc = params.get('error_description') || oauthErr;
					if (msg) msg.textContent = `로그인이 취소되었거나 거부되었습니다 (${desc}). 다시 시도해 주세요.`;
					setTimeout(() => { window.location.href = '/login'; }, 3000);
					return;
				}

				// Supabase auto-exchanges the OAuth code (detectSessionInUrl: true).
				// We listen for SIGNED_IN to know exactly when the session is ready.
				const redirect = (session: any) => {
					if (msg) msg.textContent = `로그인 성공 ✓ ${session?.user?.user_metadata?.full_name || ''}님, 환영합니다.`;
					setTimeout(() => { window.location.href = next; }, 400);
				};

				// Subscribe first in case the SIGNED_IN event fires fast
				const { data: sub } = supabase.auth.onAuthStateChange((event, session) => {
					if (event === 'SIGNED_IN' && session) {
						sub.subscription.unsubscribe();
						redirect(session);
					}
				});

				// Also check if session is already in place (refresh, back button, etc.)
				const { data: { session } } = await supabase.auth.getSession();
				if (session) {
					sub.subscription.unsubscribe();
					redirect(session);
					return;
				}

				// Fallback timeout — Supabase usually fires SIGNED_IN within 300-800ms
				setTimeout(async () => {
					const { data } = await supabase.auth.getSession();
					if (data.session) {
						redirect(data.session);
					} else {
						sub.subscription.unsubscribe();
						if (msg) msg.textContent = '로그인 정보를 받지 못했습니다. 다시 시도해 주세요.';
						setTimeout(() => { window.location.href = '/login'; }, 2000);
					}
				}, 4000);
			})();
		</script>

		<style>
			.callback {
				max-width: 480px;
				margin: var(--s-6) auto;
				padding: var(--s-4);
				text-align: center;
				background: var(--paper-soft);
				border-left: 3px solid var(--brick);
			}
			.callback h1 {
				font-family: var(--font-display);
				font-size: 1.5rem;
				margin: 0 0 var(--s-2);
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.callback p { margin: 0; color: var(--ink-medium); }
		</style>
	</body>
</html>
