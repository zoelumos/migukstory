---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { CATEGORIES } from '../../content.config';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	return Object.entries(CATEGORIES).map(([key, meta]) => ({
		params: { slug: meta.slug },
		props: {
			catKey: key,
			catMeta: meta,
			posts: all
				.filter(p => !p.data.draft && p.data.category === key)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { catMeta, posts } = Astro.props;

const HUB_COPY = {
	'immigration': {
		intent: 'USCIS, 비자, 영주권, 시민권, I-485·I-130처럼 한인 독자가 실제로 검색하는 이민 절차를 공식 발표와 함께 정리합니다.',
		queries: ['USCIS 영주권 문호', 'I-485 신분조정', '가족초청 이민', '시민권 신청', '비자 인터뷰'],
	},
	'tax': {
		intent: 'IRS 세금보고, FBAR, 해외계좌, 환급, 공제·크레딧처럼 미국 한인 가정과 자영업자가 놓치면 손해 보는 세금 이슈를 모았습니다.',
		queries: ['FBAR 한국계좌 신고', 'IRS 세금 환급', '해외금융계좌', '세금보고 마감', '한인 자영업 세금'],
	},
	'health': {
		intent: '건강보험, ACA, Medicare, Medicaid, 병원비와 약값처럼 미국 생활비에 직접 연결되는 의료·보험 정보를 정리합니다.',
		queries: ['ACA 보험료', 'Medicare 가입', 'Medicaid 자격', '건강보험 보조금'],
	},
	'real-estate': {
		intent: '모기지 금리, 렌트, 재산세, 주택보험처럼 미국 거주비를 바꾸는 부동산·주거 정보를 한인 관점으로 설명합니다.',
		queries: ['모기지 금리', '미국 렌트비', '재산세', '주택보험', '첫 주택 구입'],
	},
	'retirement': {
		intent: 'Social Security, Medicare, Medicaid, MAPT Trust, living trust, 상속·유언·위임장, 요양원 비용처럼 부모 세대와 자녀 세대가 함께 결정해야 하는 노후 법률·재정 이슈를 모았습니다.',
		queries: ['MAPT Trust', 'Medicaid planning', '요양원 비용', 'living trust', '상속·유언', 'elder law attorney'],
	},
	'economy': {
		intent: '물가, 금리, 고용, 소비, 경기 흐름이 한인 가정·자영업·은퇴계좌에 어떤 영향을 주는지 설명합니다.',
		queries: ['미국 금리', 'CPI 물가', '고용지표', '자영업 경기', '소비 둔화'],
	},
	'ai': {
		intent: 'AI 자동화가 한인 직장인, 자영업, 자녀 진로, 소상공인 마케팅에 주는 영향을 실용적으로 정리합니다.',
		queries: ['AI 일자리', 'AI 자동화', '소상공인 AI', '자녀 진로 AI'],
	},
	'robotics': {
		intent: '로봇·자동화 기술이 물류, 식당, 제조, 돌봄, 미래 직업에 어떤 변화를 만드는지 추적합니다.',
		queries: ['로봇 자동화', '물류 로봇', '휴머노이드', '미래직업'],
	},
	'community': {
		intent: '미국 한인 생활에 필요한 지역 뉴스, 정착 정보, 영사 업무, 생활 가이드를 모았습니다.',
		queries: ['한인 생활', '미국 정착', '영사 업무', 'DMV', '은행 계좌'],
	},
	'education': {
		intent: '미국 학교, 대학, 장학금, 자녀 교육과 진로 선택에 필요한 정보를 한인 학부모 관점으로 정리합니다.',
		queries: ['미국 학교', '대학 장학금', '자녀 교육', '입시'],
	},
	'consumer': {
		intent: '사기, 개인정보 유출, 리콜, 부채추심, 신용보고서처럼 한인 가정과 시니어가 바로 확인해야 할 소비자보호 이슈를 정리합니다.',
		queries: ['시니어 사기', '개인정보 유출', 'FTC 소비자보호', '제품 리콜', '신용보고서 오류'],
	},
};

const hub = HUB_COPY[catMeta.slug as keyof typeof HUB_COPY];
const topPosts = posts.slice(0, 5);
const itemListSchema = posts.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"name": `${catMeta.label} 기사 목록`,
	"itemListElement": topPosts.map((post, index) => ({
		"@type": "ListItem",
		"position": index + 1,
		"url": `https://migukstory.com/blog/${post.id}/`,
		"name": post.data.title,
	})),
} : null;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${catMeta.label} — ${SITE_TITLE}`}
			description={hub?.intent || `미국 스토리의 ${catMeta.label} 관련 기사 모음. 정부와 주요 언론의 1차 출처를 바탕으로 정리합니다.`}
			breadcrumbs={[
				{ name: '홈', url: '/' },
				{ name: catMeta.label, url: `/category/${catMeta.slug}` },
			]}
		/>
		{itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
	</head>
	<body>
		<Header />
		<main>
			<div class="container">
				<header class="cat-head" style={`--cat: ${catMeta.color}`}>
					<p class="eyebrow">CATEGORY · 카테고리</p>
					<h1>{catMeta.label}</h1>
					<p class="cat-sub">{hub?.intent || `관련 기사 ${posts.length}편`}</p>
					{hub && (
						<div class="query-cloud" aria-label="자주 찾는 검색어">
							<span class="query-label">자주 찾는 검색어</span>
							{hub.queries.map((q) => <span class="query-pill">{q}</span>)}
						</div>
					)}
					<p class="cat-count">관련 기사 {posts.length}편 · 최신순 업데이트</p>
				</header>

				{posts.length === 0 ? (
					<p class="empty">아직 이 카테고리의 글이 없습니다. 곧 업데이트됩니다.</p>
				) : (
					<>
						<!-- Sort + search filter -->
						<div class="cat-filters">
							<div class="sort-group">
								<label for="sort-select" class="filter-label">정렬</label>
								<select id="sort-select">
									<option value="newest">최신순</option>
									<option value="oldest">오래된순</option>
									<option value="title">제목순</option>
								</select>
							</div>
							<div class="search-group">
								<label for="search-input" class="sr-only">검색</label>
								<input id="search-input" type="search" placeholder="제목·설명·태그 검색..." autocomplete="off" />
							</div>
							<span class="visible-count"><span id="visible-count">{posts.length}</span>편 표시</span>
						</div>

						<ol class="list" id="cat-list">
							{posts.map((post, i) => (
								<li
									class="archive-item"
									data-title={post.data.title.toLowerCase()}
									data-desc={post.data.description.toLowerCase()}
									data-tags={(post.data.tags || []).join('|')}
									data-date={post.data.pubDate.toISOString()}
								>
									<div class="num">{String(posts.length - i).padStart(2, '0')}</div>
									<a href={`/blog/${post.id}/`} class="card">
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
										<div class="meta">
											<FormattedDate date={post.data.pubDate} />
											{post.data.tags.slice(0, 3).map((t: string) => <span class="tag">#{t}</span>)}
										</div>
									</a>
								</li>
							))}
						</ol>
						<p class="empty-filter" id="empty-filter" hidden>일치하는 글이 없습니다.</p>
					</>
				)}

								<script src="/js/category-list-filters.js" defer></script>
			</div>
		</main>
		<Footer />
		<style>
			.cat-head {
				text-align: center;
				padding: var(--s-6) 0 var(--s-3);
				border-bottom: 3px solid var(--cat, var(--ink));
				margin-bottom: var(--s-5);
			}
			.eyebrow { color: var(--cat, var(--brick)) !important; margin: 0 0 var(--s-2); }
			.cat-head h1 {
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 6vw, 4rem);
				margin: 0 0 var(--s-1);
				letter-spacing: -0.03em;
			}
			.cat-sub {
				color: var(--ink-medium);
				font-size: var(--text-base);
				line-height: 1.75;
				max-width: 48rem;
				margin: 0 auto var(--s-3);
			}
			.cat-count { color: var(--ink-light); font-size: 0.88rem; margin: var(--s-2) 0 0; }
			.query-cloud {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.55rem;
				flex-wrap: wrap;
				margin: 0 auto;
				max-width: 48rem;
			}
			.query-cloud .query-label {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				color: var(--ink-light);
			}
			.query-pill {
				display: inline-flex;
				border: 1px solid color-mix(in srgb, var(--cat, var(--brick)) 45%, var(--rule));
				background: color-mix(in srgb, var(--cat, var(--brick)) 8%, var(--paper));
				color: var(--ink);
				text-decoration: none;
				border-radius: 999px;
				padding: 0.35em 0.75em;
				font-size: 0.82rem;
			}
			.empty, .empty-filter { text-align: center; color: var(--ink-medium); padding: var(--s-4) 0; }
			.cat-filters {
				max-width: 760px;
				margin: 0 auto var(--s-2);
				display: flex;
				gap: var(--s-2);
				align-items: center;
				flex-wrap: wrap;
				padding-bottom: var(--s-2);
				border-bottom: 1px solid var(--rule);
			}
			.filter-label {
				font-size: 0.7rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--ink-light);
				margin-right: 0.4em;
			}
			.sort-group, .search-group { display: flex; align-items: center; gap: 0.4em; }
			.search-group { flex: 1; min-width: 200px; }
			#sort-select, #search-input {
				font: inherit;
				font-size: 0.85rem;
				padding: 0.35em 0.7em;
				background: var(--paper);
				border: 1px solid var(--rule);
				border-radius: 4px;
				color: var(--ink);
				flex: 1;
				min-width: 0;
			}
			#sort-select:focus, #search-input:focus { outline: none; border-color: var(--cat, var(--brick)); }
			.visible-count {
				font-size: 0.78rem;
				color: var(--ink-light);
				font-weight: 500;
			}
			.list { list-style: none; padding: 0; margin: 0; max-width: 760px; margin: 0 auto; }
			.list li {
				display: grid;
				grid-template-columns: 60px 1fr;
				gap: var(--s-3);
				padding: var(--s-3) 0;
				border-bottom: 1px solid var(--rule);
				align-items: start;
			}
			.list li:first-child { border-top: 1px solid var(--rule); }
			.num {
				font-family: var(--font-display);
				font-size: 1.75rem;
				color: var(--cat, var(--brick));
				font-weight: 700;
				line-height: 1.2;
				font-feature-settings: "tnum";
			}
			.card { text-decoration: none; color: inherit; display: block; }
			.card h2 {
				font-family: var(--font-display);
				font-size: 1.5rem;
				line-height: 1.25;
				margin: 0 0 0.5em;
				letter-spacing: -0.01em;
				color: var(--ink);
				transition: color var(--duration) var(--ease-out);
			}
			.card:hover h2 { color: var(--cat, var(--brick)); }
			.card p {
				font-size: 0.95rem;
				line-height: 1.65;
				color: var(--ink-medium);
				margin: 0 0 0.6em;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.meta {
				font-size: 0.8rem;
				color: var(--ink-light);
				display: flex;
				gap: 0.7em;
				flex-wrap: wrap;
				align-items: center;
			}
			.tag { font-size: 0.75rem; }
			@media (max-width: 720px) {
				.list li { grid-template-columns: 40px 1fr; gap: var(--s-2); }
				.num { font-size: 1.25rem; }
				.card h2 { font-size: 1.2rem; }
			}
		</style>
	</body>
</html>
