---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`검색 — ${SITE_TITLE}`}
			description="미국 스토리의 이민·세금·건강·교육·은퇴·부동산·커뮤니티 콘텐츠를 검색합니다."
			noindex
		/>
		<link rel="stylesheet" href="/_pagefind/pagefind-ui.css" />
	</head>
	<body>
		<Header />
		<main>
			<div class="container narrow">
				<header class="search-head">
					<p class="eyebrow">SEARCH · 검색</p>
					<h1>미국 스토리에서 찾기</h1>
					<p class="search-sub">
						제목·본문·태그를 한 번에 검색합니다. 한국어·영어 키워드 모두 지원합니다.
					</p>
				</header>
				<div id="search"></div>
			</div>
		</main>
		<Footer />

		<!-- External (CSP) — see public/js/search-init.js -->
		<script src="/js/search-init.js" defer></script>

		<style>
			.search-head {
				text-align: center;
				padding: var(--s-5) 0 var(--s-3);
				border-bottom: 1px solid var(--rule);
				margin-bottom: var(--s-4);
			}
			.eyebrow {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: var(--brick);
				text-transform: uppercase;
				margin: 0 0 var(--s-2);
			}
			.search-head h1 {
				font-family: var(--font-display);
				font-size: clamp(2rem, 5vw, 3rem);
				margin: 0 0 var(--s-2);
				letter-spacing: -0.03em;
			}
			.search-sub {
				color: var(--ink-medium);
				margin: 0;
				line-height: 1.7;
			}
			/* Restyle Pagefind UI to match editorial palette */
			:global(.pagefind-ui) {
				--pagefind-ui-primary: var(--brick);
				--pagefind-ui-text: var(--ink);
				--pagefind-ui-background: var(--paper);
				--pagefind-ui-border: var(--rule);
				--pagefind-ui-tag: var(--paper-soft);
				--pagefind-ui-border-width: 1px;
				--pagefind-ui-border-radius: 4px;
				--pagefind-ui-font: var(--font-body);
			}
			:global(.pagefind-ui__search-input) {
				font-family: var(--font-body) !important;
				font-size: 1rem !important;
			}
		</style>
	</body>
</html>
