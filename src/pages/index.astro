---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { CATEGORIES, type CategoryKey } from '../content.config';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Homepage editorial priority: Steve wants the top headline to be viral/high-stakes,
// not merely the newest generic item. Immigration comes first for Miguk Story's
// audience, then war/conflict/geopolitics, then major public-safety/policy items.
// The secondary "slides" also use this ranking so at least two strong items sit
// above the fold with the hero.
const viralKeywords = [
	'영주권', 'USCIS', '이민', '비자', 'I-485', '신분조정', '가족초청', '추방', 'ICE', '망명',
	'전쟁', '분쟁', '공습', '휴전', '우크라이나', '가자', '이스라엘', '중국', '북한', '대만',
	'리콜', '경보', '살모넬라', '대법원', '트럼프', '세금폭탄',
];
const newestPubDay = Math.max(...posts.map((p) => Date.UTC(
	p.data.pubDate.getUTCFullYear(),
	p.data.pubDate.getUTCMonth(),
	p.data.pubDate.getUTCDate(),
)));
const headlineScore = (post: (typeof posts)[number]) => {
	const text = `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`;
	const postDay = Date.UTC(
		post.data.pubDate.getUTCFullYear(),
		post.data.pubDate.getUTCMonth(),
		post.data.pubDate.getUTCDate(),
	);
	const ageDays = Math.max(0, Math.round((newestPubDay - postDay) / 86_400_000));
	let score = 50_000 - ageDays * 6_000;
	if (ageDays === 0) score += 30_000; // today's batch must own the hero/slides when available
	if (post.data.category === 'immigration') score += 10_000;
	if (/전쟁|분쟁|공습|휴전|우크라이나|가자|이스라엘|중국|북한|대만/i.test(text)) score += 8_000;
	if (/리콜|경보|살모넬라|대법원|트럼프|세금폭탄/i.test(text)) score += 3_000;
	viralKeywords.forEach((kw) => { if (text.includes(kw)) score += 250; });
	// Keep weak evergreen/generic economy explainers from taking the hero slot.
	if (post.data.category === 'economy' && !/전쟁|이민|USCIS|리콜|경보|대법원|트럼프/i.test(text)) score -= 5_000;
	return score;
};
const headlinePosts = [...posts].sort((a, b) => headlineScore(b) - headlineScore(a));
const [lead, ...headlineRest] = headlinePosts;
const aboveFold = headlineRest.filter((p) => p.id !== lead?.id).slice(0, 2);    // headline slides/sub-leads
const usedAboveFold = new Set([lead?.id, ...aboveFold.map((p) => p.id)]);
const cont = posts.filter((p) => !usedAboveFold.has(p.id)).slice(0, 6);          // continued page

// Group posts by category (in CATEGORIES order, skip empty)
const byCategory = (Object.keys(CATEGORIES) as CategoryKey[])
	.map(key => ({
		key,
		meta: CATEGORIES[key],
		posts: posts.filter(p => p.data.category === key),
	}))
	.filter(g => g.posts.length > 0);

const koDate = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}.`;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="site-hero">
				<div class="container site-hero-inner">
					<p class="eyebrow">MIGUK STORY · 미국 생활 뉴스 가이드</p>
					<h1 class="site-hero-title">미국 사는 한인에게 필요한 뉴스만, 출처까지 확인해서 쉽게</h1>
					<p class="site-hero-desc">
						이민·세금·건강보험·교육·은퇴·부동산까지, 오늘 결정에 필요한 정보를
						공식 자료와 한인 가정의 관점으로 정리합니다.
					</p>
				</div>
			</section>

			<!-- LEAD ARTICLE -->
			{lead && (() => {
				const leadCat = (CATEGORIES as any)[lead.data.category];
				return (
					<section class="lead">
						<div class="container lead-inner">
							<p class="eyebrow">오늘의 헤드라인</p>
							<h2 class="lead-title">
								<a href={`/blog/${lead.id}/`}>{lead.data.title}</a>
							</h2>
							<p class="lead-desc">{lead.data.description}</p>
							<div class="lead-meta">
								{leadCat && (
									<a class="cat-badge" href={`/category/${leadCat.slug}`} style={`background: ${leadCat.color}`}>
										{leadCat.label}
									</a>
								)}
								<span class="dot-sep">·</span>
								<FormattedDate date={lead.data.pubDate} />
								{lead.data.tags.slice(0, 3).map((t: string) => (
									<span class="tag-inline">#{t}</span>
								))}
							</div>
							<a class="read-link" href={`/blog/${lead.id}/`}>전문 읽기 →</a>
						</div>
					</section>
				);
			})()}

			<div class="container divider-mark"></div>

			<!-- ABOVE-FOLD headline slides (2-column) -->
			{aboveFold.length > 0 && (
				<section class="above-fold" aria-label="오늘의 주요 헤드라인 슬라이드">
					<div class="container two-col">
						{aboveFold.map((post, i) => (
							<article class="story">
								<p class="eyebrow">{i === 0 ? '헤드라인 슬라이드 1' : '헤드라인 슬라이드 2'}</p>
								<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
								<p class="story-desc">{post.data.description}</p>
								<div class="story-meta">
									<FormattedDate date={post.data.pubDate} />
									<span class="dot-sep">·</span>
									<span class="age-pill">{post.data.ageGroup}</span>
								</div>
							</article>
						))}
					</div>
				</section>
			)}

			<div class="container divider-mark"></div>

			<!-- "CONTINUED" — magazine-style listing -->
			{cont.length > 0 && (
				<section class="continued">
					<div class="container">
						<h3 class="section-title"><span>계속해서 읽기</span></h3>
						<ol class="cont-list">
							{cont.map((post, i) => (
								<li>
									<span class="cont-num">{String(i + 4).padStart(2, '0')}</span>
									<div class="cont-body">
										<a href={`/blog/${post.id}/`}><h4>{post.data.title}</h4></a>
										<p class="cont-meta">
											<span class="age-pill mini">{post.data.ageGroup}</span>
											{koDate(post.data.pubDate)}
										</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				</section>
			)}

			<div class="container divider-mark"></div>

			<!-- CONTACT CTA — single email, prominent -->
			<section class="contact-cta">
				<div class="container">
					<div class="cta-inner">
						<p class="eyebrow">CONTACT · 문의하기</p>
						<h2>여러분의 이야기를 기다립니다</h2>
						<p class="cta-sub">
							기사 제보 · 정정 요청 · 광고 문의 — 무엇이든 한 곳으로 보내주세요.<br/>
							평일 24시간 이내 답변드립니다.
						</p>
						<a class="cta-mega" href="mailto:editor@migukstory.com">
							<span class="cta-mega-label">✉ 이메일</span>
							<span class="cta-mega-email">editor@migukstory.com</span>
						</a>
						<a href="/contact" class="cta-more">전체 문의 페이지 보기 →</a>
					</div>
				</div>
			</section>

			<div class="container divider-mark"></div>

			<!-- CATEGORY SECTIONS — like Korea Daily / Korea Times -->
			<section class="by-cat">
				<div class="container">
					<h3 class="section-title"><span>섹션별 보기</span></h3>
					<div class="cat-grid">
						{byCategory.map(({ key, meta, posts: catPosts }) => (
							<div class="cat-col" style={`--cat: ${meta.color}`}>
								<header class="cat-head">
									<a href={`/category/${meta.slug}`} class="cat-label">
										{meta.label} <span class="cat-count">({catPosts.length})</span>
									</a>
								</header>
								<ul class="cat-list">
									{catPosts.slice(0, 4).map(p => (
										<li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
									))}
								</ul>
								{catPosts.length > 4 && (
									<a href={`/category/${meta.slug}`} class="cat-more">+{catPosts.length - 4}편 더 보기 →</a>
								)}
							</div>
						))}
					</div>
				</section>
			</div>
		</main>

		<Footer />

		<style>
			main { padding-bottom: var(--s-6); }

			/* ── Site hero ───────────────────────────────────────── */
			.site-hero {
				padding: var(--s-6) 0 var(--s-5);
				border-bottom: 1px solid var(--rule);
				background:
					radial-gradient(circle at 20% 10%, rgba(185, 28, 28, 0.08), transparent 32%),
					linear-gradient(180deg, var(--paper) 0%, var(--cream) 100%);
			}
			.site-hero-inner {
				max-width: 980px;
				margin: 0 auto;
				text-align: center;
			}
			.site-hero-title {
				font-family: var(--font-display);
				font-size: clamp(2.75rem, 6.5vw, 5.4rem);
				font-weight: 800;
				line-height: 1.08;
				letter-spacing: -0.045em;
				margin: 0 auto var(--s-3);
				max-width: 11em;
				word-break: keep-all;
				color: var(--ink);
			}
			.site-hero-desc {
				font-size: clamp(1.05rem, 2vw, 1.28rem);
				line-height: 1.75;
				color: var(--ink-soft);
				max-width: 46em;
				margin: 0 auto;
				word-break: keep-all;
			}

			/* ── Lead article ─────────────────────────────────────── */
			.lead {
				padding: var(--s-5) 0 var(--s-5);
				border-bottom: 1px solid var(--rule);
			}
			.lead-inner {
				max-width: 900px;
				margin: 0 auto;
			}
			.lead-inner .eyebrow { margin: 0 0 var(--s-2); }
			.lead-title {
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 5.5vw, 4.25rem);
				font-weight: 700;
				line-height: 1.18;
				letter-spacing: -0.03em;
				margin: 0 0 var(--s-3);
				word-break: keep-all;
			}
			.lead-title a {
				color: var(--ink);
				text-decoration: none;
				background-image: linear-gradient(transparent 68%, var(--cream) 68%);
				transition: background-image var(--duration) var(--ease-out);
			}
			.lead-title a:hover {
				background-image: linear-gradient(transparent 68%, var(--cream-deep) 68%);
				color: var(--brick-deep);
			}
			.lead-desc {
				font-size: var(--text-lg);
				color: var(--ink-soft);
				line-height: 1.7;
				margin: 0 0 var(--s-3);
				max-width: 38em;
			}
			.lead-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				display: flex;
				gap: var(--s-1);
				flex-wrap: wrap;
				align-items: center;
				margin-bottom: var(--s-3);
			}
			.read-link {
				display: inline-block;
				font-family: var(--font-body);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--brick);
				text-decoration: none;
				border-bottom: 2px solid var(--brick);
				padding-bottom: 2px;
				transition: all var(--duration) var(--ease-out);
			}
			.read-link:hover { color: var(--brick-deep); border-bottom-color: var(--brick-deep); }

			/* ── Meta utility pieces ──────────────────────────────── */
			.cat-badge {
				display: inline-block;
				font-size: 0.7rem;
				font-weight: 700;
				padding: 0.18em 0.6em;
				color: var(--paper);
				letter-spacing: 0.04em;
				border-radius: 2px;
				text-decoration: none;
			}
			.cat-badge:hover { opacity: 0.85; }
			.tag-inline {
				font-size: 0.78rem;
				color: var(--ink-light);
				font-weight: 500;
			}
			.dot-sep { color: var(--ink-faint); }

			/* ── Above-fold 2-column ─────────────────────────────── */
			.above-fold { padding: var(--s-4) 0; }
			.two-col {
				display: grid;
				grid-template-columns: 1fr 1px 1fr;
				gap: var(--s-5);
				align-items: start;
			}
			.two-col::after {
				content: "";
				grid-row: 1;
				grid-column: 2;
				background: var(--rule);
				height: 100%;
				min-height: 250px;
			}
			.story .eyebrow { margin: 0 0 var(--s-2); }
			.story h2 {
				font-family: var(--font-display);
				font-size: clamp(1.5rem, 2.6vw, 2.1rem);
				line-height: 1.2;
				margin: 0 0 var(--s-2);
				letter-spacing: -0.02em;
			}
			.story h2 a { color: var(--ink); text-decoration: none; }
			.story h2 a:hover { color: var(--brick); }
			.story-desc {
				font-size: 0.95rem;
				color: var(--ink-medium);
				margin: 0 0 var(--s-2);
				line-height: 1.7;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.story-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				display: flex;
				gap: var(--s-1);
				align-items: center;
				flex-wrap: wrap;
			}

			/* ── Section titles ──────────────────────────────────── */
			.section-title {
				text-align: center;
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--ink);
				position: relative;
				margin: var(--s-4) 0 var(--s-4);
				letter-spacing: -0.01em;
			}
			.section-title::before, .section-title::after {
				content: "";
				position: absolute;
				top: 50%;
				width: calc(50% - 8em);
				height: 1px;
				background: var(--rule);
			}
			.section-title::before { left: 0; }
			.section-title::after { right: 0; }
			.section-title span {
				padding: 0 var(--s-2);
				background: var(--paper);
				position: relative;
			}

			/* ── "Continued" listing ─────────────────────────────── */
			.cont-list {
				list-style: none;
				padding: 0;
				margin: 0;
				max-width: 760px;
				margin: 0 auto;
			}
			.cont-list li {
				display: grid;
				grid-template-columns: 60px 1fr;
				gap: var(--s-3);
				padding: var(--s-3) 0;
				border-bottom: 1px solid var(--rule);
				align-items: baseline;
			}
			.cont-list li:last-child { border-bottom: none; }
			.cont-num {
				font-family: var(--font-display);
				font-size: 2rem;
				color: var(--brick);
				font-weight: 700;
				line-height: 1;
				font-feature-settings: "tnum";
			}
			.cont-body h4 {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 0.3rem;
				line-height: 1.35;
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.cont-body a { text-decoration: none; color: inherit; transition: color var(--duration) var(--ease-out); }
			.cont-body a:hover h4 { color: var(--brick); }
			.cont-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				margin: 0;
				display: flex;
				gap: 0.6em;
				align-items: center;
			}

			/* ── Category grid ──────────────────────────────────── */
			.by-cat { padding: var(--s-4) 0; }
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--s-3);
			}
			.cat-col {
				padding: var(--s-3);
				background: var(--paper);
				border: 1px solid var(--rule);
				border-top: 4px solid var(--cat, var(--brick));
				border-radius: 4px;
				transition: all var(--duration) var(--ease-out);
				display: flex;
				flex-direction: column;
			}
			.cat-col:hover { box-shadow: 0 8px 22px rgba(0, 0, 0, 0.05); }
			.cat-head { margin-bottom: var(--s-2); padding-bottom: var(--s-1); border-bottom: 1px solid var(--rule); }
			.cat-label {
				display: block;
				font-family: var(--font-display);
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--ink);
				text-decoration: none;
				transition: color var(--duration) var(--ease-out);
			}
			.cat-label:hover { color: var(--cat, var(--brick)); }
			.cat-count {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--ink-light);
				font-weight: 400;
				margin-left: 0.25em;
			}
			.cat-list { list-style: none; padding: 0; margin: 0; flex: 1; }
			.cat-list li {
				font-size: 0.9rem;
				line-height: 1.5;
				padding: 0.55em 0;
				border-bottom: 1px solid var(--rule-soft);
			}
			.cat-list li:last-child { border-bottom: none; }
			.cat-list a {
				color: var(--ink-soft);
				text-decoration: none;
				font-weight: 500;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.cat-list a:hover { color: var(--cat, var(--brick)); }
			.cat-more {
				margin-top: var(--s-1);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--cat, var(--brick));
				text-decoration: none;
				padding-top: var(--s-1);
				border-top: 1px solid var(--rule-soft);
			}
			.cat-more:hover { text-decoration: underline; }

			/* ── Contact CTA ─────────────────────────────────────── */
			.contact-cta {
				padding: var(--s-5) 0 var(--s-4);
				background: var(--paper-soft);
				border-top: 1px solid var(--rule);
				border-bottom: 1px solid var(--rule);
				margin-top: var(--s-5);
			}
			.cta-inner {
				max-width: 900px;
				margin: 0 auto;
				text-align: center;
			}
			.cta-inner .eyebrow { margin: 0 0 var(--s-2); }
			.cta-inner h2 {
				font-family: var(--font-display);
				font-size: clamp(1.75rem, 3.5vw, 2.5rem);
				margin: 0 0 var(--s-2);
				letter-spacing: -0.02em;
			}
			.cta-sub {
				color: var(--ink-medium);
				margin: 0 0 var(--s-4);
				line-height: 1.7;
			}
			.cta-mega {
				display: inline-flex;
				flex-direction: column;
				gap: 0.35em;
				padding: var(--s-3) var(--s-5);
				margin-bottom: var(--s-2);
				background: var(--paper);
				border: 1px solid var(--ink);
				border-radius: 8px;
				text-decoration: none;
				color: inherit;
				transition: all var(--duration) var(--ease-out);
			}
			.cta-mega:hover {
				background: var(--ink);
				border-color: var(--ink);
				transform: translateY(-2px);
				box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
			}
			.cta-mega:hover .cta-mega-label,
			.cta-mega:hover .cta-mega-email { color: var(--paper); }
			.cta-mega-label {
				font-family: var(--font-body);
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.16em;
				color: var(--ink-light);
				transition: color var(--duration) var(--ease-out);
			}
			.cta-mega-email {
				font-family: var(--font-mono);
				font-size: clamp(1.15rem, 2.5vw, 1.6rem);
				font-weight: 700;
				color: var(--brick);
				transition: color var(--duration) var(--ease-out);
			}
			.cta-more {
				display: inline-block;
				margin-top: var(--s-2);
				font-size: 0.9rem;
				font-weight: 600;
