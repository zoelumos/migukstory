---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import HouseAd from '../components/HouseAd.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';
import { CATEGORIES, type CategoryKey } from '../content.config';
import { compareForHomepage, splitHomepageStories } from '../utils/headlinePriority';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const { lead, aboveFold, continued } = splitHomepageStories(posts);
const usedAboveFold = new Set([lead?.id, ...aboveFold.map((p) => p.id)]);
const cont = continued.filter((p) => !usedAboveFold.has(p.id)).slice(0, 6);          // continued page

// Group posts by category (in CATEGORIES order, skip empty)
const byCategory = (Object.keys(CATEGORIES) as CategoryKey[])
	.map(key => ({
		key,
		meta: CATEGORIES[key],
		posts: posts.filter(p => p.data.category === key).sort(compareForHomepage),
	}))
	.filter(g => g.posts.length > 0);

const koDate = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}.`;
const buildUpdatedAt = new Intl.DateTimeFormat('ko-KR', {
	timeZone: 'America/New_York',
	month: '2-digit',
	day: '2-digit',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
}).format(new Date());
const ageLabel = (age: string) => ({
	'all': '전체 독자',
	'20-35': '20–35세',
	'35-55': '35–55세',
	'55+': '55세+',
}[age] || age);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="site-hero">
				<div class="container site-hero-inner">
					<p class="eyebrow">MIGUK STORY · 미국 생활 뉴스 가이드</p>
					<h1 class="site-hero-title">미국 사는 한인에게 필요한 뉴스만, 출처까지 확인해서 쉽게</h1>
					<p class="site-hero-desc">
						이민·세금·건강보험·교육·은퇴·부동산까지, 오늘 결정에 필요한 정보를
						공식 자료와 한인 가정의 관점으로 정리합니다.
					</p>
				</div>
			</section>

			<!-- LEAD ARTICLE -->
			{lead && (() => {
				const leadCat = (CATEGORIES as any)[lead.data.category];
				return (
					<section class="lead">
						<div class="container lead-inner">
							<p class="eyebrow">오늘의 헤드라인</p>
							<h2 class="lead-title">
								<a href={`/blog/${lead.id}/`}>{lead.data.title}</a>
							</h2>
							<p class="lead-desc">{lead.data.description}</p>
							<div class="lead-meta">
								{leadCat && (
									<a class="cat-badge" href={`/category/${leadCat.slug}`} style={`background: ${leadCat.color}`}>
										{leadCat.label}
									</a>
								)}
								<span class="dot-sep">·</span>
								<FormattedDate date={lead.data.pubDate} />
								{lead.data.tags.slice(0, 3).map((t: string) => (
									<span class="tag-inline">#{t}</span>
								))}
							</div>
							<a class="read-link" href={`/blog/${lead.id}/`}>전문 읽기 →</a>
						</div>
					</section>
				);
			})()}

			<div class="container divider-mark"></div>

			<!-- ABOVE-FOLD must-read cards: mobile-first, not fake slides -->
			{aboveFold.length > 0 && (
				<section class="above-fold" aria-label="오늘의 머스트리드">
					<div class="container must-read-head">
						<p class="eyebrow">TODAY'S MUST-READ · 헤드라인 02–03</p>
						<h3>오늘 꼭 읽어야 할 뉴스</h3>
						<p>한인 가정과 자영업 결정에 영향이 큰 순서로 골랐습니다. <span>업데이트 {buildUpdatedAt} ET</span></p>
					</div>
					<div class="container two-col">
						{aboveFold.map((post, i) => {
							const cat = (CATEGORIES as any)[post.data.category];
							return (
								<article class="story">
									<div class="story-topline">
										<span class="story-rank">{String(i + 2).padStart(2, '0')}</span>
										{cat && (
											<a class="cat-badge" href={`/category/${cat.slug}`} style={`background: ${cat.color}`}>
												{cat.label}
											</a>
										)}
									</div>
									<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<p class="story-desc">{post.data.description}</p>
									<div class="story-meta">
										<FormattedDate date={post.data.pubDate} />
										<span class="dot-sep">·</span>
										<span class="age-pill">{ageLabel(post.data.ageGroup)}</span>
										<span class="dot-sep">·</span>
										<span class="visual-pill">표·체크리스트 중심</span>
									</div>
									<a class="story-cta" href={`/blog/${post.id}/`}>핵심 보기 →</a>
								</article>
							);
						})}
					</div>
				</section>
			)}

			<div class="container divider-mark"></div>

			<!-- ── Homepage house ad — Zoe Lumos (prominent, above the fold-ish) ─ -->
			<div class="container">
				<HouseAd site="zoelumos" variant="banner" />
			</div>

			<!-- "CONTINUED" — magazine-style listing -->
			{cont.length > 0 && (
				<section class="continued">
					<div class="container">
						<h3 class="section-title"><span>계속해서 읽기</span></h3>
						<ol class="cont-list">
							{cont.map((post, i) => (
								<li>
									<span class="cont-num">{String(i + 4).padStart(2, '0')}</span>
									<div class="cont-body">
										<a href={`/blog/${post.id}/`}><h4>{post.data.title}</h4></a>
										<p class="cont-meta">
											<span class="age-pill mini">{ageLabel(post.data.ageGroup)}</span>
											{koDate(post.data.pubDate)}
										</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				</section>
			)}

			<div class="container divider-mark"></div>

			<!-- CONTACT CTA — single email, prominent -->
			<section class="contact-cta">
				<div class="container">
					<div class="cta-inner">
						<p class="eyebrow">CONTACT · 문의하기</p>
						<h2>여러분의 이야기를 기다립니다</h2>
						<p class="cta-sub">
							기사 제보 · 정정 요청 · 광고 문의 — 무엇이든 한 곳으로 보내주세요.<br/>
							평일 24시간 이내 답변드립니다.
						</p>
						<a class="cta-mega" href="mailto:editor@migukstory.com">
							<span class="cta-mega-label">✉ 이메일</span>
							<span class="cta-mega-email">editor@migukstory.com</span>
						</a>
						<a href="/contact" class="cta-more">전체 문의 페이지 보기 →</a>
					</div>
				</div>
			</section>

			<div class="container divider-mark"></div>

			<!-- CATEGORY SECTIONS — like Korea Daily / Korea Times -->
			<section class="by-cat">
				<div class="container">
					<h3 class="section-title"><span>섹션별 보기</span></h3>
					<div class="cat-grid">
						{byCategory.map(({ key, meta, posts: catPosts }) => (
							<div class="cat-col" style={`--cat: ${meta.color}`}>
								<header class="cat-head">
									<a href={`/category/${meta.slug}`} class="cat-label">
										{meta.label} <span class="cat-count">({catPosts.length})</span>
									</a>
								</header>
								<ul class="cat-list">
									{catPosts.slice(0, 4).map(p => (
										<li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
									))}
								</ul>
								{catPosts.length > 4 && (
									<a href={`/category/${meta.slug}`} class="cat-more">+{catPosts.length - 4}편 더 보기 →</a>
								)}
							</div>
						))}
					</div>
				</section>
			</div>
		</main>

		<Footer />

		<style>
			main { padding-bottom: var(--s-6); }

			/* ── Site hero ───────────────────────────────────────── */
			.site-hero {
				padding: var(--s-6) 0 var(--s-5);
				border-bottom: 1px solid var(--rule);
				background:
					radial-gradient(circle at 20% 10%, rgba(185, 28, 28, 0.08), transparent 32%),
					linear-gradient(180deg, var(--paper) 0%, var(--cream) 100%);
			}
			.site-hero-inner {
				max-width: 980px;
				margin: 0 auto;
				text-align: center;
			}
			.site-hero-title {
				font-family: var(--font-display);
				font-size: clamp(2.75rem, 6.5vw, 5.4rem);
				font-weight: 800;
				line-height: 1.08;
				letter-spacing: -0.045em;
				margin: 0 auto var(--s-3);
				max-width: 11em;
				word-break: keep-all;
				color: var(--ink);
			}
			.site-hero-desc {
				font-size: clamp(1.05rem, 2vw, 1.28rem);
				line-height: 1.75;
				color: var(--ink-soft);
				max-width: 46em;
				margin: 0 auto;
				word-break: keep-all;
			}

			/* ── Lead article ─────────────────────────────────────── */
			.lead {
				padding: var(--s-5) 0 var(--s-5);
				border-bottom: 1px solid var(--rule);
			}
			.lead-inner {
				max-width: 900px;
				margin: 0 auto;
			}
			.lead-inner .eyebrow { margin: 0 0 var(--s-2); }
			.lead-title {
				font-family: var(--font-display);
				font-size: clamp(2.5rem, 5.5vw, 4.25rem);
				font-weight: 700;
				line-height: 1.18;
				letter-spacing: -0.03em;
				margin: 0 0 var(--s-3);
				word-break: keep-all;
			}
			.lead-title a {
				color: var(--ink);
				text-decoration: none;
				background-image: linear-gradient(transparent 68%, var(--cream) 68%);
				transition: background-image var(--duration) var(--ease-out);
			}
			.lead-title a:hover {
				background-image: linear-gradient(transparent 68%, var(--cream-deep) 68%);
				color: var(--brick-deep);
			}
			.lead-desc {
				font-size: var(--text-lg);
				color: var(--ink-soft);
				line-height: 1.7;
				margin: 0 0 var(--s-3);
				max-width: 38em;
			}
			.lead-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				display: flex;
				gap: var(--s-1);
				flex-wrap: wrap;
				align-items: center;
				margin-bottom: var(--s-3);
			}
			.read-link {
				display: inline-block;
				font-family: var(--font-body);
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--brick);
				text-decoration: none;
				border-bottom: 2px solid var(--brick);
				padding-bottom: 2px;
				transition: all var(--duration) var(--ease-out);
			}
			.read-link:hover { color: var(--brick-deep); border-bottom-color: var(--brick-deep); }

			/* ── Meta utility pieces ──────────────────────────────── */
			.cat-badge {
				display: inline-block;
				font-size: 0.7rem;
				font-weight: 700;
				padding: 0.18em 0.6em;
				color: var(--paper);
				letter-spacing: 0.04em;
				border-radius: 2px;
				text-decoration: none;
			}
			.cat-badge:hover { opacity: 0.85; }
			.tag-inline {
				font-size: 0.78rem;
				color: var(--ink-light);
				font-weight: 500;
			}
			.dot-sep { color: var(--ink-faint); }

			/* ── Above-fold must-read cards ──────────────────────── */
			.above-fold { padding: var(--s-4) 0; }
			.must-read-head {
				margin-bottom: var(--s-3);
			}
			.must-read-head .eyebrow { margin: 0 0 var(--s-1); }
			.must-read-head h3 {
				font-family: var(--font-display);
				font-size: clamp(1.55rem, 3vw, 2.15rem);
				line-height: 1.18;
				letter-spacing: -0.03em;
				margin: 0 0 0.35rem;
				color: var(--ink);
			}
			.must-read-head p:last-child {
				margin: 0;
				font-size: 0.94rem;
				color: var(--ink-medium);
				line-height: 1.55;
			}
			.must-read-head span {
				color: var(--ink-light);
				white-space: nowrap;
			}
			.two-col {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: var(--s-3);
				align-items: stretch;
			}
			.story {
				position: relative;
				display: flex;
				flex-direction: column;
				min-height: 100%;
				padding: var(--s-3);
				background: linear-gradient(180deg, var(--paper) 0%, var(--paper-soft) 100%);
				border: 1px solid var(--rule);
				border-radius: 14px;
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.045);
				transition: transform var(--duration) var(--ease-out), box-shadow var(--duration) var(--ease-out), border-color var(--duration) var(--ease-out);
			}
			.story:hover {
				transform: translateY(-3px);
				border-color: rgba(185, 28, 28, 0.32);
				box-shadow: 0 16px 34px rgba(0, 0, 0, 0.08);
			}
			.story-topline {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin: 0 0 var(--s-2);
			}
			.story-rank {
				font-family: var(--font-display);
				font-size: 1.8rem;
				font-weight: 800;
				line-height: 1;
				color: var(--brick);
				font-feature-settings: "tnum";
			}
			.story h2 {
				font-family: var(--font-display);
				font-size: clamp(1.45rem, 2.6vw, 2.05rem);
				line-height: 1.22;
				margin: 0 0 var(--s-2);
				letter-spacing: -0.025em;
				word-break: keep-all;
			}
			.story h2 a { color: var(--ink); text-decoration: none; }
			.story h2 a:hover { color: var(--brick); }
			.story-desc {
				font-size: 0.98rem;
				color: var(--ink-medium);
				margin: 0 0 var(--s-2);
				line-height: 1.68;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.story-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				display: flex;
				gap: var(--s-1);
				align-items: center;
				flex-wrap: wrap;
				margin-top: auto;
			}
			.visual-pill {
				display: inline-block;
				padding: 0.12em 0.55em;
				border: 1px solid var(--rule);
				border-radius: 999px;
				background: var(--paper);
				color: var(--ink-medium);
				font-size: 0.76rem;
				font-weight: 600;
			}
			.story-cta {
				display: inline-flex;
				align-self: flex-start;
				margin-top: var(--s-2);
				font-size: 0.88rem;
				font-weight: 700;
				color: var(--brick);
				text-decoration: none;
				border-bottom: 2px solid currentColor;
			}
			.story-cta:hover { color: var(--brick-deep); }

			/* ── Section titles ──────────────────────────────────── */
			.section-title {
				text-align: center;
				font-family: var(--font-display);
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--ink);
				position: relative;
				margin: var(--s-4) 0 var(--s-4);
				letter-spacing: -0.01em;
			}
			.section-title::before, .section-title::after {
				content: "";
				position: absolute;
				top: 50%;
				width: calc(50% - 8em);
				height: 1px;
				background: var(--rule);
			}
			.section-title::before { left: 0; }
			.section-title::after { right: 0; }
			.section-title span {
				padding: 0 var(--s-2);
				background: var(--paper);
				position: relative;
			}

			/* ── "Continued" listing ─────────────────────────────── */
			.cont-list {
				list-style: none;
				padding: 0;
				margin: 0;
				max-width: 760px;
				margin: 0 auto;
			}
			.cont-list li {
				display: grid;
				grid-template-columns: 60px 1fr;
				gap: var(--s-3);
				padding: var(--s-3) 0;
				border-bottom: 1px solid var(--rule);
				align-items: baseline;
			}
			.cont-list li:last-child { border-bottom: none; }
			.cont-num {
				font-family: var(--font-display);
				font-size: 2rem;
				color: var(--brick);
				font-weight: 700;
				line-height: 1;
				font-feature-settings: "tnum";
			}
			.cont-body h4 {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 0.3rem;
				line-height: 1.35;
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.cont-body a { text-decoration: none; color: inherit; transition: color var(--duration) var(--ease-out); }
			.cont-body a:hover h4 { color: var(--brick); }
			.cont-meta {
				font-size: var(--text-sm);
				color: var(--ink-light);
				margin: 0;
				display: flex;
				gap: 0.6em;
				align-items: center;
			}

			/* ── Category grid ──────────────────────────────────── */
			.by-cat { padding: var(--s-4) 0; }
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--s-3);
			}
			.cat-col {
				padding: var(--s-3);
				background: var(--paper);
				border: 1px solid var(--rule);
				border-top: 4px solid var(--cat, var(--brick));
				border-radius: 4px;
				transition: all var(--duration) var(--ease-out);
				display: flex;
				flex-direction: column;
			}
			.cat-col:hover { box-shadow: 0 8px 22px rgba(0, 0, 0, 0.05); }
			.cat-head { margin-bottom: var(--s-2); padding-bottom: var(--s-1); border-bottom: 1px solid var(--rule); }
			.cat-label {
				display: block;
				font-family: var(--font-display);
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--ink);
				text-decoration: none;
				transition: color var(--duration) var(--ease-out);
			}
			.cat-label:hover { color: var(--cat, var(--brick)); }
			.cat-count {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--ink-light);
				font-weight: 400;
				margin-left: 0.25em;
			}
			.cat-list { list-style: none; padding: 0; margin: 0; flex: 1; }
			.cat-list li {
				font-size: 0.9rem;
				line-height: 1.5;
				padding: 0.55em 0;
				border-bottom: 1px solid var(--rule-soft);
			}
			.cat-list li:last-child { border-bottom: none; }
			.cat-list a {
				color: var(--ink-soft);
				text-decoration: none;
				font-weight: 500;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.cat-list a:hover { color: var(--cat, var(--brick)); }
			.cat-more {
				margin-top: var(--s-1);
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--cat, var(--brick));
				text-decoration: none;
				padding-top: var(--s-1);
				border-top: 1px solid var(--rule-soft);
			}
			.cat-more:hover { text-decoration: underline; }

			/* ── Contact CTA ─────────────────────────────────────── */
			.contact-cta {
				padding: var(--s-5) 0 var(--s-4);
				background: var(--paper-soft);
				border-top: 1px solid var(--rule);
				border-bottom: 1px solid var(--rule);
				margin-top: var(--s-5);
			}
			.cta-inner {
				max-width: 900px;
				margin: 0 auto;
				text-align: center;
			}
			.cta-inner .eyebrow { margin: 0 0 var(--s-2); }
			.cta-inner h2 {
				font-family: var(--font-display);
				font-size: clamp(1.75rem, 3.5vw, 2.5rem);
				margin: 0 0 var(--s-2);
				letter-spacing: -0.02em;
			}
			.cta-sub {
				color: var(--ink-medium);
				margin: 0 0 var(--s-4);
				line-height: 1.7;
			}
			.cta-mega {
				display: inline-flex;
				flex-direction: column;
