			}
			.cta-more:hover { color: var(--brick); border-bottom-color: var(--brick); }

			/* ── Responsive ──────────────────────────────────────── */
			@media (max-width: 900px) {
				.two-col {
					display: grid;
					grid-auto-flow: column;
