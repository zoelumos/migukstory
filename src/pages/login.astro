---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`로그인 — ${SITE_TITLE}`}
			description="미국 스토리에 Google 계정으로 로그인하면 댓글을 남기실 수 있습니다."
			noindex={true}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="container narrow">
				<header class="login-head">
					<p class="eyebrow">SIGN IN · 로그인</p>
					<h1>댓글을 남기시려면<br/><span class="brick">Google로 로그인</span></h1>
					<p class="lead">
						이메일 가입 없이 Google 계정으로 1초 만에 시작하세요.
						미국 스토리는 댓글 작성 이외에 어떤 정보도 사용하지 않습니다.
					</p>
				</header>

				<aside class="already-in" hidden data-logged-in-notice>
					<p><strong data-name>이미</strong>님으로 로그인되어 있습니다.</p>
					<div class="already-actions">
						<a href="/" class="btn-link">홈으로 →</a>
						<a href="/api/auth/logout?next=/login" class="btn-link secondary">다른 계정으로 로그인</a>
					</div>
				</aside>

				<div class="login-card">
					<a id="google-signin" class="btn-google" href={`/api/auth/signin?provider=google&next=${encodeURIComponent('/')}`} aria-label="Google로 로그인">
						<svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
							<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
							<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
							<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
							<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571c.001-.001.002-.001.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
						</svg>
						<span>Google로 계속하기</span>
					</a>

					<div class="divider"><span>또는</span></div>

					<form id="email-magic-link">
						<label for="email-input" class="sr-only">이메일</label>
						<input
							id="email-input"
							type="email"
							name="email"
							placeholder="email@example.com"
							autocomplete="email"
							required
						/>
						<button type="submit" class="btn-magic">이메일로 매직 링크 받기</button>
					</form>

					<p class="msg" data-msg></p>

					<p class="legal">
						로그인 시 <a href="/privacy">개인정보처리방침</a>과
						<a href="/disclosure">이용 안내</a>에 동의하시는 것으로 간주됩니다.
						미국 스토리는 Google에서 받은 이메일·이름·프로필 사진만 저장합니다.
					</p>
				</div>

				<div class="why">
					<h2>왜 로그인이 필요한가요?</h2>
					<ul>
						<li><strong>댓글 작성</strong> — 다른 독자와 의견을 나누기 위해서만 필요합니다.</li>
						<li><strong>본인 댓글 수정·삭제</strong> — 작성 후 15분간 본인 댓글을 수정하실 수 있습니다.</li>
						<li><strong>스팸 방지</strong> — 익명 댓글에서 발생하는 무분별한 스팸을 차단합니다.</li>
						<li><strong>광고 없음</strong> — 미국 스토리는 로그인 정보를 광고에 사용하지 않습니다.</li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			// All OAuth + magic-link flows are server-side (HttpOnly cookies).
			const params = new URLSearchParams(window.location.search);
			const next = params.get('next') || '/';

			// One-time localStorage cleanup — removes leftover verifier/token entries
			// from the pre-migration localStorage architecture. Safe no-op once cleared.
			try {
				Object.keys(localStorage).filter((k) => k.startsWith('sb-')).forEach((k) => localStorage.removeItem(k));
			} catch (e) { /* private mode etc. */ }

			// If already logged in, show a soft notice (don't auto-redirect — that
			// confuses users who explicitly navigated here to switch accounts).
			fetch('/api/auth/session', { credentials: 'same-origin' })
				.then((r) => r.json())
				.then((data) => {
					if (data.authenticated && data.user) {
						const notice = document.querySelector('[data-logged-in-notice]') as HTMLElement | null;
						if (notice) {
							const nameEl = notice.querySelector('[data-name]');
							if (nameEl) nameEl.textContent = data.user.name;
							notice.hidden = false;
						}
					}
				})
				.catch(() => {});

			// Surface server error if redirected back from a failed callback
			const errParam = params.get('error');
			if (errParam) {
				setTimeout(() => setMsg(decodeURIComponent(errParam), 'error'), 100);
			}

			const msgEl = document.querySelector('[data-msg]') as HTMLElement | null;
			const setMsg = (text: string, kind: 'success' | 'error' | 'info' = 'info') => {
				if (!msgEl) return;
				msgEl.textContent = text;
				msgEl.dataset.kind = kind;
			};

			// Google sign-in is now a plain <a> link to /api/auth/signin?provider=google
			// (server generates PKCE verifier as HttpOnly cookie, redirects to Google).
			// Just patch the href to include the current `next` param.
			const googleLink = document.getElementById('google-signin') as HTMLAnchorElement | null;
			if (googleLink) {
				googleLink.href = `/api/auth/signin?provider=google&next=${encodeURIComponent(next)}`;
			}

			// Email magic link — POST to server-side /api/auth/magic-link
			document.getElementById('email-magic-link')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target as HTMLFormElement;
				const email = String(new FormData(form).get('email') || '').trim().toLowerCase();
				if (!email.includes('@')) {
					setMsg('올바른 이메일을 입력해 주세요.', 'error');
					return;
				}
				setMsg('전송 중…', 'info');
				const res = await fetch('/api/auth/magic-link', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, next }),
				});
				const result = await res.json().catch(() => ({}));
				if (!res.ok) {
					setMsg(result.error || '이메일 전송에 실패했습니다. 잠시 후 다시 시도해 주세요.', 'error');
				} else {
					setMsg(`${email}으로 로그인 링크를 보내드렸습니다. 메일을 확인해 주세요.`, 'success');
					form.reset();
				}
			});
		</script>

		<style>
			.login-head {
				text-align: center;
				padding: var(--s-6) 0 var(--s-3);
				border-bottom: 1px solid var(--rule);
				margin-bottom: var(--s-4);
			}
			.eyebrow {
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				color: var(--brick);
				text-transform: uppercase;
				margin: 0 0 var(--s-2);
			}
			.login-head h1 {
				font-family: var(--font-display);
				font-size: clamp(2rem, 5vw, 3.25rem);
				line-height: 1.1;
				margin: 0 0 var(--s-3);
				letter-spacing: -0.03em;
			}
			.brick { color: var(--brick); }
			.lead {
				font-size: var(--text-base);
				color: var(--ink-medium);
				max-width: 32em;
				margin: 0 auto;
				line-height: 1.7;
			}

			.already-in {
				max-width: 420px;
				margin: 0 auto var(--s-3);
				padding: var(--s-2) var(--s-3);
				background: #ECFDF5;
				border-left: 3px solid #047857;
				border-radius: 0 4px 4px 0;
				text-align: center;
			}
			.already-in p { margin: 0 0 var(--s-2); color: var(--ink); font-size: 0.95rem; }
			.already-in strong { color: #047857; font-weight: 700; }
			.already-actions { display: flex; gap: var(--s-2); justify-content: center; flex-wrap: wrap; }
			.btn-link {
				display: inline-block;
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--paper);
				background: var(--brick);
				padding: 0.45em 0.9em;
				border-radius: 3px;
				text-decoration: none;
			}
			.btn-link.secondary { background: var(--paper); color: var(--ink); border: 1px solid var(--rule); }
			.btn-link:hover { opacity: 0.9; }

			.login-card {
				max-width: 420px;
				margin: 0 auto var(--s-5);
				padding: var(--s-4) var(--s-3);
				background: var(--paper);
				border: 1px solid var(--rule);
				border-radius: 6px;
				box-shadow: 0 1px 0 rgba(27,24,21,0.04);
			}
			.btn-google {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.7em;
				width: 100%;
				padding: 0.85em 1em;
				font-family: inherit;
				font-size: 0.98rem;
				font-weight: 600;
				color: #3C3C3C;
				background: #fff;
				border: 1px solid #DADCE0;
				border-radius: 4px;
				cursor: pointer;
				transition: background var(--duration), border-color var(--duration), box-shadow var(--duration);
			}
			.btn-google:hover {
				background: #F8F9FA;
				border-color: var(--ink-light);
				box-shadow: 0 1px 3px rgba(60,64,67,0.15);
			}
			.divider {
				display: flex;
				align-items: center;
				gap: var(--s-2);
				margin: var(--s-3) 0;
				color: var(--ink-light);
				font-size: 0.78rem;
			}
			.divider::before, .divider::after {
				content: "";
				flex: 1;
				height: 1px;
				background: var(--rule);
			}
			#email-magic-link {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			#email-magic-link input {
				padding: 0.8em 1em;
				border: 1px solid var(--rule);
				border-radius: 4px;
				font: inherit;
				font-size: 0.95rem;
				background: var(--paper);
			}
			#email-magic-link input:focus {
				outline: none;
				border-color: var(--brick);
			}
			.btn-magic {
				padding: 0.8em 1em;
				background: var(--ink);
				color: var(--paper);
				border: none;
				border-radius: 4px;
				font-weight: 600;
				font-size: 0.95rem;
				cursor: pointer;
				font-family: inherit;
				transition: background var(--duration);
			}
			.btn-magic:hover { background: var(--brick); }

			.msg {
				margin: var(--s-2) 0 0;
				font-size: 0.88rem;
				min-height: 1.2em;
				text-align: center;
			}
			.msg[data-kind="success"] { color: #047857; font-weight: 600; }
			.msg[data-kind="info"]    { color: var(--ink-medium); }
			.msg[data-kind="error"]   { color: var(--brick); }

			.legal {
				margin: var(--s-3) 0 0;
				font-size: 0.72rem;
				color: var(--ink-light);
				line-height: 1.6;
				text-align: center;
				border-top: 1px dotted var(--rule);
				padding-top: var(--s-2);
			}
			.legal a { color: var(--ink-medium); border-bottom: 1px solid currentColor; text-decoration: none; }
			.legal a:hover { color: var(--brick); }

			.why {
				max-width: 520px;
				margin: 0 auto var(--s-5);
				padding: var(--s-3);
				background: var(--paper-soft);
				border-left: 3px solid var(--brick);
			}
			.why h2 {
				font-family: var(--font-display);
				font-size: 1.2rem;
				margin: 0 0 var(--s-2);
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.why ul {
				margin: 0;
				padding-left: 1.2em;
				font-size: 0.92rem;
				line-height: 1.7;
				color: var(--ink-medium);
			}
			.why li { margin-bottom: 0.4em; }
			.why strong { color: var(--ink); }
		</style>
	</body>
</html>
