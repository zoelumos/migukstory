---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const status = Astro.url.searchParams.get('status') || 'ok';
const messages: Record<string, { title: string; body: string }> = {
	ok: {
		title: '구독 요청이 접수되었습니다',
		body: '이미 구독 중인 이메일이면 중복 없이 기존 구독을 유지합니다. 매주 화요일 미국 생활에 필요한 정보를 보내드리겠습니다.',
	},
	invalid: {
		title: '이메일을 다시 확인해 주세요',
		body: '입력한 이메일 형식이 올바르지 않습니다. 이전 페이지로 돌아가 이메일 주소를 다시 입력해 주세요.',
	},
	error: {
		title: '잠시 후 다시 시도해 주세요',
		body: '구독 요청을 처리하는 중 문제가 생겼습니다. 문제가 계속되면 editor@migukstory.com 으로 알려주세요.',
	},
};
const message = messages[status] || messages.ok;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${message.title} | 미국 스토리`} description={message.body} noindex={true} />
	</head>
	<body>
		<Header />
		<main class="subscribed-page">
			<section class="subscribed-card">
				<p class="kicker">뉴스레터</p>
				<h1>{message.title}</h1>
				<p>{message.body}</p>
				<div class="actions">
					<a class="primary" href="/">홈으로 가기</a>
					<a href="/blog/">최신 글 보기</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.subscribed-page { max-width: 760px; margin: 0 auto; padding: var(--s-6) var(--s-3); }
	.subscribed-card { background: var(--paper-soft); border-left: 4px solid var(--brick); border-radius: 0 8px 8px 0; padding: var(--s-5); }
	.kicker { margin: 0 0 var(--s-2); color: var(--brick); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
	h1 { font-family: var(--font-display); margin: 0 0 var(--s-2); color: var(--ink); }
	p { color: var(--ink-medium); line-height: 1.7; }
	.actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
	.actions a { color: var(--brick); font-weight: 700; text-decoration: none; }
	.actions a.primary { background: var(--brick); color: #fff; border-radius: 4px; padding: 0.7em 1em; }
</style>
