---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`MFA 등록 — 관리자 — ${SITE_TITLE}`}
			description="관리자 2단계 인증 (TOTP) 등록"
			noindex={true}
			breadcrumbs={[
				{ name: '홈', url: '/' },
				{ name: '관리자', url: '/admin' },
				{ name: 'MFA 등록', url: '/admin/enroll-mfa' },
			]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="container narrow">
				<header class="mfa-head">
					<p class="eyebrow">SECURITY · 2단계 인증</p>
					<h1>관리자 TOTP 등록</h1>
					<p class="lead" data-status>로그인 상태 확인 중…</p>
				</header>

				<!-- Not admin -->
				<aside class="locked" hidden data-not-admin>
					<p>이 페이지는 관리자 전용입니다.</p>
					<a href="/">홈으로 →</a>
				</aside>

				<!-- Enroll flow -->
				<section class="enroll" hidden data-enroll>
					<ol class="steps">
						<li>
							<h3>1. 인증 앱 준비</h3>
							<p>Google Authenticator, 1Password, Authy 같은 TOTP 앱을 설치하세요.</p>
						</li>
						<li>
							<h3>2. QR 코드 스캔 또는 시크릿 키 입력</h3>
							<div class="qr-row">
								<div class="qr-wrap" data-qr-wrap><span>QR 코드 생성 중…</span></div>
								<div class="secret-wrap">
									<p class="secret-label">시크릿 키 (수동 입력용)</p>
									<code class="secret" data-secret></code>
								</div>
							</div>
						</li>
						<li>
							<h3>3. 앱에서 생성된 6자리 코드 입력</h3>
							<form data-verify-form>
								<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required />
								<button type="submit">확인 + 등록 완료</button>
							</form>
							<p class="msg" data-msg></p>
						</li>
					</ol>
				</section>

				<!-- Already verified -->
				<aside class="done" hidden data-done>
					<h2>등록 완료 ✓</h2>
					<p>TOTP 2단계 인증이 활성화되어 있습니다. 다음 로그인 시 인증 앱의 6자리 코드를 입력하세요.</p>
					<p><a href="/admin" rel="nofollow">관리자 대시보드로 →</a></p>
				</aside>

				<!-- Challenge required (already enrolled but session is aal1) -->
				<aside class="challenge" hidden data-challenge>
					<h2>2단계 인증이 필요합니다</h2>
					<p>인증 앱에서 6자리 코드를 입력해 세션을 AAL2로 격상하세요.</p>
					<form data-challenge-form>
						<input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required />
						<button type="submit">코드 확인</button>
					</form>
					<p class="msg" data-challenge-msg></p>
				</aside>
			</div>
		</main>
		<Footer />

		<script>
			import { supabase } from '../../lib/supabase';

			const statusEl = document.querySelector('[data-status]') as HTMLElement | null;
			const notAdmin = document.querySelector('[data-not-admin]') as HTMLElement | null;
			const enrollEl = document.querySelector('[data-enroll]') as HTMLElement | null;
			const doneEl = document.querySelector('[data-done]') as HTMLElement | null;
			const challengeEl = document.querySelector('[data-challenge]') as HTMLElement | null;
			const qrWrap = document.querySelector('[data-qr-wrap]') as HTMLElement | null;
			const secretEl = document.querySelector('[data-secret]') as HTMLElement | null;
			const msgEl = document.querySelector('[data-msg]') as HTMLElement | null;
			const challengeMsg = document.querySelector('[data-challenge-msg]') as HTMLElement | null;

			let activeFactorId: string | null = null;

			(async () => {
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) {
					if (statusEl) statusEl.textContent = '로그인이 필요합니다.';
					if (notAdmin) { notAdmin.hidden = false; const a = notAdmin.querySelector('a'); if (a) a.textContent = '로그인 →'; if (a) a.href = '/login?next=/admin/enroll-mfa'; }
					return;
				}
				const { data: profile } = await supabase.from('profiles').select('is_admin, display_name').eq('id', session.user.id).maybeSingle();
				if (!profile?.is_admin) {
					if (statusEl) statusEl.textContent = '관리자 권한이 없습니다.';
					if (notAdmin) notAdmin.hidden = false;
					return;
				}
				if (statusEl) statusEl.textContent = `${profile.display_name || session.user.email} (관리자)`;

				const { data: factors } = await supabase.auth.mfa.listFactors();
				const verifiedTotp = factors?.totp?.find((f: any) => f.status === 'verified');
				const unverified = factors?.totp?.find((f: any) => f.status === 'unverified');

				if (verifiedTotp) {
					const { data: aal } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
					if (aal?.currentLevel === 'aal2') {
						// Already AAL2 — show done state
						if (doneEl) doneEl.hidden = false;
					} else {
						// Enrolled but not challenged this session — show challenge
						activeFactorId = verifiedTotp.id;
						if (challengeEl) challengeEl.hidden = false;
					}
					return;
				}

				// New enrollment (delete stale unverified first to avoid duplicates)
				if (unverified) {
					await supabase.auth.mfa.unenroll({ factorId: unverified.id });
				}
				const { data: enroll, error } = await supabase.auth.mfa.enroll({
					factorType: 'totp',
					friendlyName: 'migukstory-admin-' + Date.now(),
				});
				if (error || !enroll) {
					if (statusEl) statusEl.textContent = 'TOTP 등록 실패: ' + (error?.message || '알 수 없는 오류');
					return;
				}
				activeFactorId = enroll.id;
				if (qrWrap) qrWrap.innerHTML = `<img alt="TOTP QR Code" src="${enroll.totp.qr_code}" />`;
				if (secretEl) secretEl.textContent = enroll.totp.secret;
				if (enrollEl) enrollEl.hidden = false;
			})();

			// Verify enrollment
			document.querySelector('[data-verify-form]')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target as HTMLFormElement;
				const code = String(new FormData(form).get('code') || '').trim();
				if (!activeFactorId) return;
				if (msgEl) { msgEl.textContent = '확인 중…'; msgEl.dataset.kind = 'info'; }
				const { error } = await supabase.auth.mfa.challengeAndVerify({ factorId: activeFactorId, code });
				if (error) {
					if (msgEl) { msgEl.textContent = '코드가 올바르지 않습니다. 다시 시도해 주세요.'; msgEl.dataset.kind = 'error'; }
					return;
				}
				if (msgEl) { msgEl.textContent = '등록 완료 ✓ AAL2 활성화. 잠시 후 관리자 대시보드로 이동합니다.'; msgEl.dataset.kind = 'success'; }
				setTimeout(() => { window.location.href = '/admin'; }, 1200);
			});

			// Challenge existing factor
			document.querySelector('[data-challenge-form]')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target as HTMLFormElement;
				const code = String(new FormData(form).get('code') || '').trim();
				if (!activeFactorId) return;
				if (challengeMsg) { challengeMsg.textContent = '확인 중…'; challengeMsg.dataset.kind = 'info'; }
				const { error } = await supabase.auth.mfa.challengeAndVerify({ factorId: activeFactorId, code });
				if (error) {
					if (challengeMsg) { challengeMsg.textContent = '코드가 올바르지 않습니다.'; challengeMsg.dataset.kind = 'error'; }
					return;
				}
				if (challengeMsg) { challengeMsg.textContent = 'AAL2 격상 완료. 이동 중…'; challengeMsg.dataset.kind = 'success'; }
				setTimeout(() => { window.location.href = '/admin'; }, 800);
			});
		</script>

		<style>
			.mfa-head { text-align: center; padding: var(--s-5) 0 var(--s-3); border-bottom: 1px solid var(--rule); margin-bottom: var(--s-4); }
			.eyebrow { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; color: var(--brick); text-transform: uppercase; margin: 0 0 var(--s-2); }
			.mfa-head h1 { font-family: var(--font-display); font-size: 2.2rem; margin: 0 0 var(--s-2); letter-spacing: -0.02em; color: var(--ink); }
			.lead { color: var(--ink-medium); margin: 0; }

			.locked, .done, .challenge { max-width: 480px; margin: 0 auto var(--s-4); padding: var(--s-3); background: var(--paper-soft); border-left: 3px solid var(--brick); }
			.done h2, .challenge h2 { font-family: var(--font-display); font-size: 1.3rem; margin: 0 0 var(--s-2); color: var(--ink); }
			.done a, .locked a { color: var(--brick); border-bottom: 1px solid currentColor; text-decoration: none; }

			.enroll { max-width: 560px; margin: 0 auto; }
			.steps { list-style: none; padding: 0; margin: 0; counter-reset: s; }
			.steps li { background: var(--paper); border: 1px solid var(--rule); padding: var(--s-3); margin-bottom: var(--s-2); border-radius: 4px; }
			.steps h3 { font-family: var(--font-display); font-size: 1.1rem; margin: 0 0 var(--s-2); color: var(--ink); letter-spacing: -0.01em; }
			.steps p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink-medium); }

			.qr-row { display: flex; gap: var(--s-3); align-items: flex-start; margin-top: var(--s-2); flex-wrap: wrap; }
			.qr-wrap { width: 180px; height: 180px; background: var(--paper-soft); border: 1px solid var(--rule); border-radius: 4px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
			.qr-wrap img { width: 100%; height: 100%; }
			.secret-wrap { flex: 1; min-width: 200px; }
			.secret-label { font-size: 0.75rem; color: var(--ink-light); margin: 0 0 0.4em; text-transform: uppercase; letter-spacing: 0.1em; }
			.secret { display: block; font-family: var(--font-mono); font-size: 0.92rem; background: var(--paper-soft); padding: 0.5em 0.8em; border-radius: 3px; word-break: break-all; color: var(--ink); }

			form { display: flex; gap: 0.5em; margin-top: var(--s-2); }
			form input { flex: 1; padding: 0.7em 1em; font-family: var(--font-mono); font-size: 1.1rem; letter-spacing: 0.3em; text-align: center; border: 1px solid var(--rule); border-radius: 4px; background: var(--paper); }
			form input:focus { outline: none; border-color: var(--brick); }
			form button { padding: 0.7em 1.2em; background: var(--brick); color: var(--paper); border: none; border-radius: 4px; font-weight: 600; cursor: pointer; font-family: inherit; }
			form button:hover { background: var(--brick-deep); }
			.msg { margin: var(--s-2) 0 0; font-size: 0.88rem; min-height: 1.2em; }
			.msg[data-kind="success"] { color: #047857; font-weight: 600; }
			.msg[data-kind="error"]   { color: var(--brick); }
			.msg[data-kind="info"]    { color: var(--ink-medium); }
		</style>
	</body>
</html>
