---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, SITE_AUTHOR, SITE_URL, AUTHORS, ORG_SAME_AS, DEFAULT_AUTHOR_SLUG } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	article?: {
		pubDate: Date;
		updatedDate?: Date;
		tags?: string[];
		author?: string;   // author slug looked up in AUTHORS (consts.ts)
	};
	breadcrumbs?: { name: string; url: string }[];
	faq?: { q: string; a: string }[];
	howTo?: {
		name: string;
		totalTime?: string;
		steps: { name: string; text: string }[];
	};
	noindex?: boolean;   // utility pages (login, auth, 404) — keep out of the index
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage, article, breadcrumbs, faq, howTo, noindex } = Astro.props;

// JSON-LD schema for rich results
const orgSchema = {
	"@context": "https://schema.org",
	"@type": "NewsMediaOrganization",
	"name": SITE_TITLE,
	"alternateName": ["Miguk Story", "미국 스토리"],
	"url": SITE_URL,
	"description": "한국계 미국인을 위한 검증된 정보 가이드",
	"inLanguage": "ko",
	"logo": {
		"@type": "ImageObject",
		"url": `${SITE_URL}/logo-512.png`,
		"width": 512,
		"height": 512,
	},
	"publishingPrinciples": `${SITE_URL}/about`,
	"actionableFeedbackPolicy": `${SITE_URL}/contact`,
	"correctionsPolicy": `${SITE_URL}/disclosure`,
	"foundingDate": "2026-01-01",
	"sameAs": ORG_SAME_AS,
};

// WebSite schema — enables the sitelinks search box (Pagefind search at /search/)
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"alternateName": "Miguk Story",
	"url": SITE_URL,
	"inLanguage": "ko",
	"publisher": { "@type": "NewsMediaOrganization", "name": SITE_TITLE, "url": SITE_URL },
	"potentialAction": {
		"@type": "SearchAction",
		"target": {
			"@type": "EntryPoint",
			"urlTemplate": `${SITE_URL}/search/?q={search_term_string}`,
		},
		"query-input": "required name=search_term_string",
	},
};
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbs.map((b, i) => ({
		"@type": "ListItem",
		"position": i + 1,
		"name": b.name,
		"item": new URL(b.url, SITE_URL).toString(),
	})),
} : null;

// Author resolution: prefer named Person schema (better E-E-A-T) when author slug is known,
// else fall back to Organization (legacy behavior preserved for posts without explicit author).
const authorSlug = article?.author || DEFAULT_AUTHOR_SLUG;
const authorInfo = AUTHORS[authorSlug];
const authorSchema = authorInfo
	? {
		"@type": "Person",
		"name": authorInfo.name,
		...(authorInfo.nameEn ? { "alternateName": authorInfo.nameEn } : {}),
		"jobTitle": authorInfo.jobTitle,
		"url": `${SITE_URL}/authors/${authorSlug}/`,
		"description": authorInfo.bio,
		"knowsAbout": authorInfo.expertise,
		...(authorInfo.email ? { "email": authorInfo.email } : {}),
		...(authorInfo.sameAs.length > 0 ? { "sameAs": authorInfo.sameAs } : {}),
		"worksFor": {
			"@type": "NewsMediaOrganization",
			"name": SITE_TITLE,
			"url": SITE_URL,
		},
	}
	: {
		"@type": "Organization",
		"name": SITE_AUTHOR,
		"url": `${SITE_URL}/about`,
	};

const articleSchema = article ? {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": title,
	"description": description,
	"datePublished": article.pubDate.toISOString(),
	"dateModified": (article.updatedDate || article.pubDate).toISOString(),
	"author": authorSchema,
	"publisher": orgSchema,
	"mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL.toString() },
	"image": {
		"@type": "ImageObject",
		"url": new URL(image.src, Astro.url).toString(),
		"width": image.width,
		"height": image.height,
	},
	"keywords": article.tags?.join(", "),
	"inLanguage": "ko",
	"isAccessibleForFree": true,
	"speakable": {
		"@type": "SpeakableSpecification",
		"cssSelector": [".article-title", ".article-deck", ".prose h2", ".prose p"],
	},
} : null;

const faqSchema = faq && faq.length > 0 ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faq.map((item) => ({
		"@type": "Question",
		"name": item.q,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.a,
		},
	})),
} : null;

const howToSchema = howTo ? {
	"@context": "https://schema.org",
	"@type": "HowTo",
	"name": howTo.name,
	"totalTime": howTo.totalTime,
	"step": howTo.steps.map((s, i) => ({
		"@type": "HowToStep",
		"position": i + 1,
		"name": s.name,
		"text": s.text,
	})),
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Search Console — service-account ownership (migukstory-indexing@) for the Indexing API -->
<meta name="google-site-verification" content="dnvnDPQvgxPwi_fmRFS3BkNbFuEwJcIPE90XZYQ45m8" />

<!--
  Font loading strategy (perf-tuned):
  Body    = Pretendard Variable from jsdelivr CDN (Korean dynamic subset, async)
  Display = Gowun Batang — SELF-HOSTED, subsetted WOFF2 (~450KB/weight vs the
            8.4MB unsubsetted TTF Google Fonts serves for Korean). Cuts ~16MB
            of font payload to ~900KB and removes the gstatic dependency.
  System Korean fonts (Apple SD Gothic Neo / Malgun Gothic) render first.
-->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="preload" href="/fonts/gowun-batang-400.woff2" as="font" type="font/woff2" crossorigin />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  media="print"
  onload="this.media='all'; this.onload=null"
/>
<noscript>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
</noscript>
<style is:inline>
  /* Self-hosted Gowun Batang — subsetted (Hangul + Latin + punctuation) WOFF2 */
  @font-face {
    font-family: 'Gowun Batang';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/gowun-batang-400.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Gowun Batang';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/gowun-batang-700.woff2') format('woff2');
  }
</style>

<!-- Mermaid diagram loader (lazy, only when post has diagrams) -->
<script type="module" is:inline>
  // Astro uses Shiki which wraps mermaid in <pre data-language="mermaid"> with span tokens
  const shikiBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (shikiBlocks.length > 0) {
    shikiBlocks.forEach((pre) => {
      const code = pre.textContent || '';
      const wrapper = document.createElement('div');
      wrapper.className = 'mermaid-wrapper';
      const mermaidPre = document.createElement('pre');
      mermaidPre.className = 'mermaid';
      mermaidPre.textContent = code;
      wrapper.appendChild(mermaidPre);
      pre.replaceWith(wrapper);
    });
    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
    mermaid.initialize({
      startOnLoad: true,
      theme: 'base',
      securityLevel: 'loose',
      fontFamily: 'Pretendard Variable, Pretendard, sans-serif',
      themeVariables: {
        primaryColor: '#FAF8F3',
        primaryTextColor: '#1B1815',
        primaryBorderColor: '#7E2B2B',
        lineColor: '#5C544B',
        secondaryColor: '#F2E9D5',
        tertiaryColor: '#E8DCC0',
        background: '#FAF8F3',
      },
    });
    await mermaid.run({ querySelector: 'pre.mermaid' });
  }
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- JSON-LD structured data — Organization + WebSite + Breadcrumbs + Article + FAQ + HowTo -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{breadcrumbSchema && (
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{articleSchema && (
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
{faqSchema && (
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
{howToSchema && (
	<script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
)}

<!-- AdSense (uncomment after approval — replace with your publisher ID) -->
<!--
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>
-->

<!-- Reading progress bar -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('article');
    if (!article) return;
    const bar = document.createElement('div');
    bar.className = 'reading-progress';
    document.body.appendChild(bar);
    const onScroll = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
