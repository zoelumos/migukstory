---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import UserMenu from './UserMenu.astro';

const navLinks = [
	{ href: '/blog', label: '전체 글' },
	{ href: '/category/immigration', label: '이민·비자' },
	{ href: '/category/tax', label: '세금·재테크' },
	{ href: '/category/economy', label: '경제·산업' },
	{ href: '/category/health', label: '건강·보험' },
	{ href: '/category/education', label: '교육·자녀' },
	{ href: '/category/retirement', label: '은퇴·연금' },
	{ href: '/category/community', label: '한인 커뮤니티' },
	{ href: '/first-30-days', label: '도착 첫 30일' },
	{ href: '/topics', label: '전체 토픽' },
	{ href: '/pros', label: '추천 전문가' },
	{ href: '/contribute', label: '칼럼 기고' },
];
---

<header class="masthead">
	<div class="utility-strip">
		<div class="container utility-inner">
			<a href="mailto:editor@migukstory.com" class="utility-cta">✉ 문의·제보 — editor@migukstory.com</a>
		</div>
	</div>

	<div class="container masthead-inner">
		<div class="meta-left">
			<span class="tagline">{SITE_TAGLINE}</span>
		</div>
		<a href="/" class="brand">
			<span class="brand-ko">{SITE_TITLE}</span>
			<span class="brand-en">MIGUK&nbsp;STORY</span>
		</a>
		<div class="meta-right">
			<UserMenu />
			<a href="/contact" class="contact-pill">문의하기 →</a>
			<button
				class="nav-toggle"
				type="button"
				aria-label="메뉴 열기"
				aria-expanded="false"
				aria-controls="primary-nav"
			>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<nav class="primary-nav" id="primary-nav">
		<div class="container nav-inner">
			{navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
			<a href="/search" class="search-link" aria-label="검색">🔍 검색</a>
			<a href="/login" class="mobile-login-link">로그인</a>
			<a href="/contact" class="contact-link">문의 · 제보</a>
		</div>
	</nav>
</header>

<!-- Hamburger JS lives in /public/js/nav-toggle.js — served as an external same-origin
     file because the production CSP blocks inline scripts (no 'unsafe-inline'). -->
<script src="/js/nav-toggle.js" defer></script>

<style>
	.masthead {
		background: var(--paper);
		border-bottom: 1px solid var(--ink);
		position: relative;
		z-index: 10;
	}
	.masthead-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: var(--s-2) var(--s-3);
		gap: var(--s-3);
	}
	.utility-strip {
		background: var(--ink);
		color: var(--paper);
		padding: 0.45em 0;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}
	.utility-inner {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.7em;
		flex-wrap: wrap;
	}
	.utility-cta {
		color: var(--paper);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: 0.04em;
	}
	.utility-cta:hover { color: var(--brick-soft); }
	.tagline {
		font-family: var(--font-body);
		font-size: 0.78rem;
		color: var(--ink-medium);
		letter-spacing: 0;
		text-transform: none;
	}

	.meta-left, .meta-right {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-light);
		font-feature-settings: "tnum";
	}
	.meta-right { text-align: right; display: inline-flex; align-items: center; gap: var(--s-2); justify-content: flex-end; }
	.contact-pill {
		display: inline-block;
		padding: 0.35em 0.8em;
		background: var(--brick);
		color: white !important;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		border-radius: 3px;
		text-decoration: none;
		transition: background var(--duration) var(--ease-out);
	}
	.contact-pill:hover { background: var(--brick-deep); }
	.brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: var(--ink);
		line-height: 1;
		gap: 0.25rem;
	}
	.brand-ko {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.brand-en {
		font-size: 0.6rem;
		font-weight: 500;
		letter-spacing: 0.4em;
		color: var(--brick);
	}

	/* Hamburger button — hidden on desktop */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 44px;
		height: 44px;
		padding: 0;
		background: transparent;
		border: 1px solid var(--rule);
		border-radius: 4px;
		cursor: pointer;
	}
	.nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		margin: 0 auto;
		background: var(--ink);
		transition: transform var(--duration) var(--ease-out), opacity var(--duration) var(--ease-out);
	}
	.masthead.nav-open .nav-toggle-bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
	.masthead.nav-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
	.masthead.nav-open .nav-toggle-bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

	.primary-nav {
		border-top: 3px double var(--ink);
		background: var(--paper);
	}
	.nav-inner {
		display: flex;
		justify-content: center;
		gap: var(--s-4);
		padding: var(--s-1) var(--s-3);
		flex-wrap: wrap;
	}
	.nav-inner a {
		text-decoration: none;
		color: var(--ink-soft);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		padding: 0.4em 0;
		position: relative;
		transition: color var(--duration) var(--ease-out);
	}
	.nav-inner a::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--brick);
		transition: all var(--duration) var(--ease-out);
		transform: translateX(-50%);
	}
	.nav-inner a:hover { color: var(--brick); }
	.nav-inner a:hover::after { width: 80%; }
	.contact-link {
		color: var(--brick) !important;
		font-weight: 700;
	}
	.mobile-login-link { display: none; }
	.contact-link::before {
		content: "→ ";
		font-weight: 700;
	}

	@media (max-width: 720px) {
		/* Mobile: utility-strip hidden, brand row tightened, nav collapses
		   into a hamburger drawer. Header lands ~64px so H1 stays above fold. */
		.utility-strip { display: none; }
		.masthead-inner {
			grid-template-columns: auto 1fr auto;
			text-align: left;
			gap: var(--s-2);
			padding: var(--s-2);
		}
		.meta-left { display: none; }
		.meta-right { text-align: right; font-size: 0.65rem; gap: 0.5em; }
		.brand { align-items: flex-start; }
		.brand-ko { font-size: 1.45rem; line-height: 1; }
		.brand-en { font-size: 0.5rem; letter-spacing: 0.3em; }
		.meta-right :global(.user-menu) { display: none; } /* avoid the anonymous loading pill beside hamburger */
		.contact-pill { display: none; }   /* lives inside the drawer on mobile */
		.nav-toggle {
			display: flex;
			background: var(--paper);
			border-color: var(--rule-strong, var(--rule));
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		}

		/* Nav becomes a vertical drawer, collapsed by default */
		.primary-nav {
			border-top: 1px solid var(--rule);
			max-height: 0;
			overflow: hidden;
			transition: max-height var(--duration) var(--ease-out);
		}
		.masthead.nav-open .primary-nav {
			max-height: 80vh;
			overflow-y: auto;
		}
		.nav-inner {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: var(--s-1) 0;
		}
		.nav-inner a {
			display: flex;
			align-items: center;
			min-height: 48px;          /* WCAG / Google tap-target minimum */
			padding: 0 var(--s-3);
			font-size: 0.95rem;
			border-bottom: 1px solid var(--rule);
		}
		.nav-inner a:last-child { border-bottom: none; }
		.nav-inner a::after { display: none; }
		.nav-inner a:active { background: var(--paper-soft); }
		.mobile-login-link { display: flex; }
	}
</style>
