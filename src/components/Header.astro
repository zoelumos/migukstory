---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import UserMenu from './UserMenu.astro';

// Icons render only in the mobile drawer (hidden on desktop) so the desktop
// nav row stays a plain text list. DOM order below == desktop row order.
const categoryLinks = [
	{ href: '/blog', label: '전체 글', icon: '📰' },
	{ href: '/category/immigration', label: '이민·비자', icon: '🛂' },
	{ href: '/category/tax', label: '세금·재테크', icon: '💰' },
	{ href: '/category/economy', label: '경제·산업', icon: '📈' },
	{ href: '/category/ai', label: 'AI·자동화', icon: '🤖' },
	{ href: '/category/robotics', label: '로봇·미래직업', icon: '🦾' },
	{ href: '/category/health', label: '건강·보험', icon: '🏥' },
	{ href: '/category/education', label: '교육·자녀', icon: '🎓' },
	{ href: '/category/retirement', label: '노후·상속·요양', icon: '🌴' },
	{ href: '/category/real-estate', label: '부동산·주거', icon: '🏠' },
	{ href: '/category/consumer', label: '사기·소비자보호', icon: '🛡️' },
	{ href: '/category/community', label: '한인 커뮤니티', icon: '🤝' },
];

const moreLinks = [
	{ href: '/guides', label: '가이드 허브', icon: '🧭' },
	{ href: '/first-30-days', label: '도착 첫 30일', icon: '🛬' },
	{ href: '/topics', label: '전체 토픽', icon: '🗂️' },
	{ href: '/pros', label: '추천 전문가', icon: '⭐' },
	{ href: '/contribute', label: '칼럼 기고', icon: '✍️' },
];

// Highlight the nav link for the section the reader is currently in.
// Server-rendered (no client JS) so it stays CSP-safe.
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	currentPath === href ||
	currentPath === `${href}/` ||
	currentPath.startsWith(`${href}/`);
---

<header class="masthead">
	<div class="utility-strip">
		<div class="container utility-inner">
			<a href="mailto:editor@migukstory.com" class="utility-cta utility-email">✉ 문의·제보 — editor@migukstory.com</a>
			<a
				href="https://zoelumos.com"
				class="utility-cta utility-promo"
				target="_blank"
				rel="noopener"
			>🌐 한인 비즈니스 웹사이트 제작 — <strong>Zoe&nbsp;Lumos</strong> →</a>
		</div>
	</div>

	<div class="container masthead-inner">
		<div class="meta-left">
			<span class="tagline">{SITE_TAGLINE}</span>
		</div>
		<a href="/" class="brand">
			<span class="brand-ko">{SITE_TITLE}</span>
			<span class="brand-en">MIGUK&nbsp;STORY</span>
		</a>
		<div class="meta-right">
			<UserMenu />
			<a href="/contact" class="contact-pill">문의하기 →</a>
			<button
				class="nav-toggle"
				type="button"
				aria-label="메뉴 열기"
				aria-expanded="false"
				aria-controls="primary-nav"
			>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
				<span class="nav-toggle-bar" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<nav class="primary-nav" id="primary-nav">
		<div class="container nav-inner">
			<p class="nav-label" id="nav-label-cat">카테고리</p>
			<div class="nav-grid" role="group" aria-labelledby="nav-label-cat">
				{categoryLinks.map((l) => (
					<a href={l.href} class="nav-item" aria-current={isActive(l.href) ? 'page' : undefined}>
						<span class="nav-icon" aria-hidden="true">{l.icon}</span>
						<span class="nav-text">{l.label}</span>
					</a>
				))}
			</div>

			<p class="nav-label" id="nav-label-more">바로가기</p>
			<div class="nav-more" role="group" aria-labelledby="nav-label-more">
				{moreLinks.map((l) => (
					<a href={l.href} class="nav-item" aria-current={isActive(l.href) ? 'page' : undefined}>
						<span class="nav-icon" aria-hidden="true">{l.icon}</span>
						<span class="nav-text">{l.label}</span>
					</a>
				))}
			</div>

			<div class="nav-cta">
				<a href="/search" class="nav-cta-btn nav-search" aria-label="검색">
					<span aria-hidden="true">🔍</span> 검색
				</a>
				<a href="/login/" class="nav-cta-btn nav-login mobile-login-link" rel="nofollow">
					<span aria-hidden="true">👤</span> 로그인
				</a>
				<a href="/contact" class="nav-cta-btn nav-contact contact-link">문의 · 제보</a>
			</div>
		</div>
	</nav>
</header>

<!-- Hamburger JS lives in /public/js/nav-toggle.js — served as an external same-origin
     file because the production CSP blocks inline scripts (no 'unsafe-inline'). -->
<script src="/js/nav-toggle.js" defer></script>

<style>
	.masthead {
		background: var(--paper);
		border-bottom: 1px solid var(--ink);
		position: relative;
		z-index: 10;
	}
	.masthead-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: var(--s-2) var(--s-3);
		gap: var(--s-3);
	}
	.utility-strip {
		background: var(--ink);
		color: var(--paper);
		padding: 0.45em 0;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}
	.utility-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.7em;
		flex-wrap: wrap;
	}
	.utility-cta {
		color: var(--paper);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: 0.04em;
	}
	.utility-cta:hover { color: var(--brick-soft); }
	.utility-promo strong { color: var(--brick-soft); font-weight: 700; }
	.utility-promo:hover strong { color: var(--paper); }
	.tagline {
		font-family: var(--font-body);
		font-size: 0.78rem;
		color: var(--ink-medium);
		letter-spacing: 0;
		text-transform: none;
	}

	.meta-left, .meta-right {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-light);
		font-feature-settings: "tnum";
	}
	.meta-right { text-align: right; display: inline-flex; align-items: center; gap: var(--s-2); justify-content: flex-end; }
	.contact-pill {
		display: inline-block;
		padding: 0.35em 0.8em;
		background: var(--brick);
		color: white !important;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		border-radius: 3px;
		text-decoration: none;
		transition: background var(--duration) var(--ease-out);
	}
	.contact-pill:hover { background: var(--brick-deep); }
	.brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: var(--ink);
		line-height: 1;
		gap: 0.25rem;
	}
	.brand-ko {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.brand-en {
		font-size: 0.6rem;
		font-weight: 500;
		letter-spacing: 0.4em;
		color: var(--brick);
	}

	/* Hamburger button — hidden on desktop */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 44px;
		height: 44px;
		padding: 0;
		background: transparent;
		border: 1px solid var(--rule);
		border-radius: 4px;
		cursor: pointer;
	}
	.nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		margin: 0 auto;
		background: var(--ink);
		transition: transform var(--duration) var(--ease-out), opacity var(--duration) var(--ease-out);
	}
	.masthead.nav-open .nav-toggle-bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
	.masthead.nav-open .nav-toggle-bar:nth-child(2) { opacity: 0; }
	.masthead.nav-open .nav-toggle-bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

	.primary-nav {
		border-top: 3px double var(--ink);
		background: var(--paper);
	}
	.nav-inner {
		display: flex;
		justify-content: center;
		gap: var(--s-4);
		padding: var(--s-1) var(--s-3);
		flex-wrap: wrap;
	}
	.nav-inner a {
		text-decoration: none;
		color: var(--ink-soft);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		padding: 0.4em 0;
		position: relative;
		transition: color var(--duration) var(--ease-out);
	}
	.nav-inner a::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--brick);
		transition: all var(--duration) var(--ease-out);
		transform: translateX(-50%);
	}
	.nav-inner a:hover,
	.nav-inner a[aria-current="page"] { color: var(--brick); }
	.nav-inner a:hover::after,
	.nav-inner a[aria-current="page"]::after { width: 80%; }
	.contact-link {
		color: var(--brick) !important;
		font-weight: 700;
	}
	.mobile-login-link { display: none; }
	.contact-link::before {
		content: "→ ";
		font-weight: 700;
	}

	/* Desktop flattens the mobile groups back into one row: display:contents
	   drops the wrapper boxes so their <a> children become direct flex items
	   of .nav-inner. Labels + icons are mobile-only. Desktop is unchanged. */
	.nav-grid,
	.nav-more,
	.nav-cta { display: contents; }
	.nav-label,
	.nav-icon { display: none; }

	@media (max-width: 720px) {
		:global(html.nav-drawer-open),
		:global(html.nav-drawer-open body) {
			overflow-x: hidden;
		}

		/* Mobile: keep the top strip but show only the Zoe Lumos promo (drop the
		   editor email to save height), brand row tightened, nav collapses into a
		   hamburger drawer. Header lands ~64px so H1 stays above fold. */
		.utility-email { display: none; }
		.utility-inner { justify-content: center; }
		.utility-promo { font-size: 0.68rem; }
		.masthead-inner {
			grid-template-columns: auto 1fr auto;
			text-align: left;
			gap: var(--s-2);
			padding: var(--s-2);
		}
		.meta-left { display: none; }
		.meta-right { text-align: right; font-size: 0.65rem; gap: 0.5em; }
		.brand { align-items: flex-start; }
		.brand-ko { font-size: 1.45rem; line-height: 1; }
		.brand-en { font-size: 0.5rem; letter-spacing: 0.3em; }
		.meta-right :global(.user-menu) { display: none; } /* avoid the anonymous loading pill beside hamburger */
		.contact-pill { display: none; }   /* lives inside the drawer on mobile */
		.nav-toggle {
			display: flex;
			background: var(--paper);
			border-color: var(--rule-strong, var(--rule));
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		}

		/* Nav becomes a vertical drawer, collapsed by default */
		.primary-nav {
			border-top: 1px solid var(--rule);
			max-height: 0;
			overflow: hidden;
			transition: max-height var(--duration) var(--ease-out);
		}
		.masthead.nav-open .primary-nav {
			max-height: 80vh;
			overflow-y: auto;
		}
		/* Mobile drawer: a compact card grid instead of a long plain list */
		.nav-inner {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: var(--s-2);
		}

		/* Search / login / contact CTAs — pulled to the top of the drawer */
		.nav-cta {
			display: flex;
			flex-wrap: wrap;
			gap: var(--s-1);
			order: -1;
		}
		.nav-cta-btn {
			flex: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.4em;
			min-height: 48px;          /* WCAG tap-target minimum */
			border: 1px solid var(--rule);
			border-radius: 8px;
			font-size: 0.9rem;
			font-weight: 700;
			letter-spacing: 0.02em;
			text-decoration: none;
		}
		.nav-inner a.nav-cta-btn::after,
		.nav-inner a.nav-item::after { display: none; }
		.nav-inner a.nav-search { background: var(--paper-soft); color: var(--ink); }
		.nav-search:active { background: var(--rule); }
		.nav-inner a.nav-login {
			display: flex;             /* override base .mobile-login-link { display:none } */
			background: var(--cream);
			color: var(--brick-deep) !important;
			border-color: var(--brick);
			box-shadow: 0 2px 0 var(--brick);
		}
		.nav-inner a.nav-login:hover {
			background: var(--cream-deep);
			color: var(--brick-deep) !important;
		}
		.nav-inner a.nav-login:focus-visible {
			outline: 2px solid var(--brick);
			outline-offset: 2px;
			background: var(--cream-deep);
		}
		.nav-inner a.nav-login:active {
			background: var(--brick);
			border-color: var(--brick);
			color: #fff !important;
		}
		.nav-inner a.nav-contact {
			flex-basis: 100%;
			margin-top: var(--s-1);
			background: var(--brick);
			color: #fff !important;    /* override base .contact-link red text */
			border-color: var(--brick);
		}
		.nav-contact::before { content: none; }   /* drop desktop "→ " prefix */
		.nav-contact:active { background: var(--brick-deep); }

		/* Section labels (mobile-only) */
		.nav-label {
			display: block;
			margin: var(--s-2) 0 var(--s-1);
			font-size: var(--text-xs);
			font-weight: 700;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--ink-light);
		}

		/* Category + shortcut card grids */
		.nav-grid,
		.nav-more {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--s-1);
		}
		.nav-inner a.nav-item {
			display: flex;
			align-items: center;
			gap: 0.6em;
			min-height: 56px;          /* generous tap target */
			padding: 0 0.7em;
			border: 1px solid var(--rule);
			border-radius: 10px;
			background: var(--paper);
			font-size: 0.9rem;
			font-weight: 600;
			color: var(--ink-soft);
		}
		.nav-item:active { background: var(--paper-soft); }
		.nav-icon {
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			width: 34px;
			height: 34px;
			font-size: 1.15rem;
			line-height: 1;
			background: var(--paper-soft);
			border: 1px solid var(--rule-soft);
			border-radius: 8px;
		}
		.nav-text {
			flex: 1;
			min-width: 0;
		}
		.nav-inner a.nav-item[aria-current="page"] {
			border-color: var(--brick);
			background: color-mix(in srgb, var(--brick) 7%, transparent);
			color: var(--brick);
		}
		.nav-item[aria-current="page"] .nav-icon {
			background: var(--brick);
			border-color: var(--brick);
			color: #fff;
		}
	}
</style>
