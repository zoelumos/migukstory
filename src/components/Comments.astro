---
/**
 * Comments — Supabase-backed, Google OAuth gated.
 *
 * Replaces the old Giscus integration. Stores comments in public.comments
 * (one row per comment, post_slug = pathname). Anyone can read non-hidden
 * comments; only logged-in users can write; authors can edit own within 15 min.
 *
 * Schema: migrations/002_profiles_comments.sql
 *
 * Future Phase 3 additions: nested replies (parent_id), reactions (jsonb),
 * @-mentions, moderation queue via Supabase MCP.
 */
---

<section class="comments-section" data-post-slug={Astro.url.pathname}>
	<header class="comments-head">
		<h2>댓글 <span class="count" data-count></span></h2>
		<p class="comments-sub">
			Google 계정으로 로그인하면 댓글을 남기실 수 있습니다 · 스팸 차단 · 비방 자동 숨김
		</p>
	</header>

	<!-- Compose form (only shown when logged in) -->
	<form class="comment-form" hidden data-compose>
		<div class="compose-head">
			<img class="me-avatar" alt="" data-me-avatar />
			<span class="me-name" data-me-name></span>
		</div>
		<label class="sr-only" for="comment-body">댓글 내용</label>
		<textarea
			id="comment-body"
			name="body"
			rows="3"
			placeholder="이 글에 대한 의견을 한국어로 남겨주세요."
			minlength="2"
			maxlength="5000"
			required
		></textarea>
		<div class="compose-actions">
			<span class="char-count" data-char>0 / 5000</span>
			<button type="submit" class="btn-post">댓글 게시</button>
		</div>
	</form>

	<!-- Login prompt (when logged out) -->
	<aside class="login-prompt" hidden data-login-prompt>
		<p>댓글을 남기시려면 Google 계정으로 로그인해 주세요.</p>
		<a class="btn-login" id="comments-login-link" href="/login" rel="nofollow">Google로 로그인 →</a>
	</aside>

	<!-- Comment list -->
	<ol class="comment-list" data-comment-list>
		<li class="loading">댓글을 불러오는 중…</li>
	</ol>
</section>

<!-- Comments JS must be external: production CSP blocks inline scripts. -->
<script src="/js/comments.js" defer></script>

<style>
	.comments-section {
		max-width: var(--reading-width);
		margin: var(--s-5) auto var(--s-4);
		padding: var(--s-3) var(--s-2);
		border-top: 1px solid var(--rule);
	}
	.comments-head {
		margin-bottom: var(--s-3);
	}
	.comments-head h2 {
		font-family: var(--font-display);
		font-size: 1.6rem;
		margin: 0 0 0.3em;
		color: var(--ink);
		letter-spacing: -0.02em;
	}
	.count {
		font-size: 1rem;
		color: var(--ink-light);
		font-weight: 500;
		font-feature-settings: "tnum";
	}
	.comments-sub {
		font-size: 0.85rem;
		color: var(--ink-light);
		margin: 0;
	}

	.comment-form {
		margin: var(--s-3) 0 var(--s-4);
		padding: var(--s-3);
		background: var(--paper-soft);
		border: 1px solid var(--rule);
		border-radius: 4px;
	}
	.compose-head {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-bottom: var(--s-2);
		font-size: 0.85rem;
	}
	.me-avatar, .c-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		object-fit: cover;
		background: var(--paper);
	}
	.me-name { font-weight: 600; color: var(--ink); }
	.comment-form textarea {
		width: 100%;
		padding: 0.7em 0.9em;
		font: inherit;
		font-size: 0.95rem;
		line-height: 1.6;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: var(--paper);
		color: var(--ink);
		resize: vertical;
		min-height: 80px;
	}
	.comment-form textarea:focus {
		outline: none;
		border-color: var(--brick);
	}
	.compose-actions {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: var(--s-2);
		gap: var(--s-2);
	}
	.char-count {
		font-size: 0.75rem;
		color: var(--ink-light);
		font-feature-settings: "tnum";
	}
	.btn-post {
		padding: 0.55em 1em;
		background: var(--brick);
		color: var(--paper);
		border: none;
		border-radius: 4px;
		font-weight: 600;
		font-size: 0.88rem;
		cursor: pointer;
		font-family: inherit;
		transition: background var(--duration);
	}
	.btn-post:hover { background: var(--brick-deep); }
	.btn-post:disabled { opacity: 0.6; cursor: wait; }

	.login-prompt {
		margin: var(--s-3) 0 var(--s-4);
		padding: var(--s-3);
		background: var(--paper-soft);
		border: 1px dashed var(--rule);
		border-radius: 4px;
		text-align: center;
	}
	.login-prompt p { margin: 0 0 var(--s-2); color: var(--ink-medium); font-size: 0.95rem; }
	.btn-login {
		display: inline-block;
		padding: 0.6em 1.2em;
		background: var(--ink);
		color: var(--paper);
		border-radius: 4px;
		font-weight: 600;
		font-size: 0.92rem;
		text-decoration: none;
		transition: background var(--duration);
	}
	.btn-login:hover { background: var(--brick); }

	.comment-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.comment-list .loading, .comment-list .empty {
		padding: var(--s-3);
		text-align: center;
		color: var(--ink-light);
		font-size: 0.9rem;
	}
	.comment {
		padding: var(--s-3) 0;
		border-bottom: 1px solid var(--rule);
	}
	.comment:last-child { border-bottom: none; }
	.c-head {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-bottom: var(--s-1);
	}
	.c-avatar-fallback {
		width: 28px; height: 28px;
		border-radius: 50%;
		background: var(--brick);
		color: var(--paper);
		display: flex; align-items: center; justify-content: center;
		font-weight: 700;
		font-size: 0.8rem;
	}
	.c-name { font-weight: 600; font-size: 0.88rem; color: var(--ink); }
	.c-time {
		font-size: 0.75rem;
		color: var(--ink-light);
		margin-left: auto;
		font-feature-settings: "tnum";
	}
	.c-body {
		margin: 0;
		padding-left: 36px;
		font-size: 0.95rem;
		line-height: 1.7;
		color: var(--ink);
		word-break: keep-all;
	}
</style>
