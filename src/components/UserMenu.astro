---
/**
 * UserMenu — hydrates via /api/auth/session (HttpOnly cookies, never touches tokens).
 * Logout via /api/auth/logout (server-side global signOut).
 */
---

<div class="user-menu" data-state="loading">
	<span class="skeleton" aria-hidden="true"></span>
	<a class="login-link" href="/login" rel="nofollow" hidden>로그인</a>
	<div class="user-pill" hidden>
		<a class="admin-chip" href="/admin" rel="nofollow" hidden title="관리자 대시보드">관리자</a>
		<img class="avatar" alt="" />
		<span class="display-name"></span>
		<a class="logout-link" href="/api/auth/logout" rel="nofollow">로그아웃</a>
	</div>
</div>

<script>
	const root = document.querySelector('.user-menu') as HTMLElement | null;
	if (root) {
		const skeleton = root.querySelector('.skeleton') as HTMLElement | null;
		const loginLink = root.querySelector('.login-link') as HTMLAnchorElement | null;
		const pill = root.querySelector('.user-pill') as HTMLElement | null;
		const avatar = root.querySelector('.avatar') as HTMLImageElement | null;
		const nameEl = root.querySelector('.display-name') as HTMLElement | null;
		const adminChip = root.querySelector('.admin-chip') as HTMLAnchorElement | null;

		const renderLoggedOut = () => {
			root.dataset.state = 'logged-out';
			if (skeleton) skeleton.hidden = true;
			if (loginLink) loginLink.hidden = false;
			if (pill) pill.hidden = true;
		};
		const renderLoggedIn = (user: any) => {
			root.dataset.state = 'logged-in';
			if (skeleton) skeleton.hidden = true;
			if (loginLink) loginLink.hidden = true;
			if (pill) pill.hidden = false;
			if (nameEl) nameEl.textContent = user.name;
			if (avatar) {
				if (user.avatar_url) { avatar.src = user.avatar_url; avatar.hidden = false; }
				else { avatar.hidden = true; }
			}
			if (adminChip) {
				adminChip.hidden = !user.is_admin;
			}
		};

		fetch('/api/auth/session', { credentials: 'same-origin' })
			.then((r) => r.json())
			.then((data) => {
				if (data.authenticated && data.user) renderLoggedIn(data.user);
				else renderLoggedOut();
			})
			.catch(() => renderLoggedOut());
	}
</script>

<style>
	.user-menu {
		display: inline-flex;
		align-items: center;
		min-height: 28px;
		min-width: 60px;
	}
	.user-menu [hidden] { display: none !important; }
	.skeleton {
		display: inline-block;
		width: 60px;
		height: 24px;
		background: linear-gradient(90deg, var(--paper-soft) 0%, var(--rule) 50%, var(--paper-soft) 100%);
		background-size: 200% 100%;
		border-radius: 999px;
		animation: skel 1.2s ease-in-out infinite;
	}
	@keyframes skel { 0% { background-position: -100% 0; } 100% { background-position: 100% 0; } }
	.login-link {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		padding: 0.35em 0.8em;
		border: 1px solid var(--rule);
		border-radius: 999px;
		letter-spacing: 0.04em;
		transition: all var(--duration) var(--ease-out);
	}
	.login-link:hover { color: var(--brick); border-color: var(--brick); }
	.user-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.78rem;
		color: var(--ink);
	}
	.avatar {
		width: 24px; height: 24px;
		border-radius: 50%;
		object-fit: cover;
		background: var(--paper-soft);
	}
	.display-name {
		font-weight: 600;
		max-width: 10ch;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.logout-link {
		font-size: 0.72rem;
		color: var(--ink-light);
		text-decoration: none;
		padding: 0.2em 0.5em;
		border-radius: 3px;
		transition: color var(--duration);
	}
	.logout-link:hover { color: var(--brick); }
	.admin-chip {
		display: inline-block;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--paper);
		background: var(--brick);
		padding: 0.2em 0.55em;
		border-radius: 3px;
		text-decoration: none;
		text-transform: uppercase;
		transition: background var(--duration);
	}
	.admin-chip:hover { background: var(--brick-deep); }
</style>
