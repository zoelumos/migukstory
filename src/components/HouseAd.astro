---
/**
 * HouseAd — display-style ad card for ZOE STUDIO's own properties
 * (zoelumos.com, konacoffeedonut.com). Styled to read as an advertisement
 * (광고 badge + headline + CTA button), not as editorial chrome. Drop it into
 * the in-article ad slots and the homepage so it sits in prime, visible spots.
 *
 * Usage:
 *   <HouseAd site="zoelumos" />
 *   <HouseAd site="kona" variant="banner" />
 */

interface Props {
	site: 'zoelumos' | 'kona';
	/** "card" (default, in-article) or "banner" (wide, homepage). */
	variant?: 'card' | 'banner';
}

const { site, variant = 'card' } = Astro.props;

const ADS = {
	zoelumos: {
		emoji: '🌐',
		vendor: 'Zoe Lumos · 한인 웹디자인 스튜디오',
		headline: '한인 비즈니스 웹사이트, 전환되도록 만듭니다',
		blurb:
			'바이링궐(한/영) 웹사이트 · Shopify · SEO · 로컬 검색 최적화. 식당·뷰티·이커머스·의료까지, 2019년부터 150여 건. 6주 만에 검색 노출 5배 사례.',
		cta: '무료 견적 받기',
		href: 'https://zoelumos.com',
	},
	kona: {
		emoji: '☕🍩',
		vendor: 'Kona Coffee Donut · 와이키키',
		headline: '와이키키에서 100% 코나 커피 & 모찌 도넛',
		blurb:
			'와이키키 비치 도보 5분. 호놀룰루 100% 코나 커피와 매일 굽는 모찌 도넛·말라사다·빙수. 하와이 여행이라면 아침은 여기서.',
		cta: '메뉴·위치 보기',
		href: 'https://konacoffeedonut.com',
	},
} as const;

const ad = ADS[site];
---

<aside class={`house-ad house-ad-${variant} house-ad-${site}`} aria-label="광고">
	<header class="house-ad-head">
		<span class="house-ad-badge">광고 · AD</span>
		<span class="house-ad-emoji" aria-hidden="true">{ad.emoji}</span>
	</header>
	<div class="house-ad-body">
		<p class="house-ad-vendor">{ad.vendor}</p>
		<h4 class="house-ad-headline">{ad.headline}</h4>
		<p class="house-ad-blurb">{ad.blurb}</p>
	</div>
	<a class="house-ad-cta" href={ad.href} target="_blank" rel="noopener">{ad.cta} →</a>
</aside>

<style>
	.house-ad {
		max-width: var(--reading-width);
		margin: var(--s-4) auto;
		padding: var(--s-3);
		background: var(--paper-soft);
		border: 1px solid var(--rule);
		border-left: 4px solid var(--brick);
		border-radius: 0 4px 4px 0;
	}
	.house-ad-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--s-2);
	}
	.house-ad-badge {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--brick);
		background: var(--paper);
		border: 1px solid var(--brick);
		padding: 0.2em 0.7em;
		border-radius: 999px;
	}
	.house-ad-emoji { font-size: 1.3rem; line-height: 1; }
	.house-ad-vendor {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-light);
		margin: 0 0 0.3em;
	}
	.house-ad-headline {
		font-family: var(--font-display);
		font-size: 1.35rem;
		margin: 0 0 0.5em;
		color: var(--ink);
		letter-spacing: -0.01em;
		line-height: 1.3;
	}
	.house-ad-blurb {
		font-size: 0.92rem;
		color: var(--ink-medium);
		line-height: 1.6;
		margin: 0 0 var(--s-2);
	}
	.house-ad-cta {
		display: inline-block;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--paper);
		background: var(--brick);
		padding: 0.6em 1.2em;
		border-radius: 3px;
		text-decoration: none;
		transition: background var(--duration) var(--ease-out);
	}
	.house-ad-cta:hover { background: var(--brick-deep); }

	/* Wide banner variant for the homepage: headline + CTA side by side. */
	.house-ad-banner {
		max-width: none;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--s-3);
	}
	.house-ad-banner .house-ad-head {
		flex-direction: column;
		gap: 0.4em;
		margin: 0;
	}
	.house-ad-banner .house-ad-emoji { font-size: 2rem; }
	.house-ad-banner .house-ad-body { min-width: 0; }
	.house-ad-banner .house-ad-blurb { margin-bottom: 0; }
	.house-ad-banner .house-ad-cta { white-space: nowrap; }

	@media (max-width: 640px) {
		.house-ad-banner {
			grid-template-columns: 1fr;
			text-align: left;
		}
		.house-ad-banner .house-ad-head { flex-direction: row; }
	}
</style>
