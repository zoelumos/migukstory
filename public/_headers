  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com https://*.supabase.co https://static.cloudflareinsights.com https://cdn.jsdelivr.net/npm/mermaid@11/; script-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com https://*.supabase.co https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://fonts.googleapis.com https://accounts.google.com https://cloudflareinsights.com; frame-src https://accounts.google.com https://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto: https://accounts.google.com https://*.supabase.co

